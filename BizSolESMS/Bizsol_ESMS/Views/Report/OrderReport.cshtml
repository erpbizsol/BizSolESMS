@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<link href="~/assets/css/esms-dashboard.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>

<style>
    .ord-report-page {
        --ord-primary: #033764;
        --ord-primary-rgb: 3, 55, 100;
        --ord-surface: #ffffff;
        --ord-muted: #64748b;
        --ord-border: #e2e8f0;
        max-width: 1440px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 4px 2rem;
    }

    #layout-wrapper.esms-webiz .main-content:has(.ord-report-page) {
        background: linear-gradient(160deg, #eff6ff 0%, #eef2ff 35%, #f0fdfa 70%, #f5f6fa 100%) !important;
        background-image: none !important;
    }

    .ord-report-page .ord-filter-panel {
        position: relative;
        background: var(--ord-surface);
        border: 1px solid rgba(var(--ord-primary-rgb), 0.12);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(var(--ord-primary-rgb), 0.07);
        margin-bottom: 0.75rem;
        overflow: hidden;
    }

    .ord-report-page .ord-filter-panel::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, #2563eb, #4f46e5, #0891b2);
    }

    .ord-report-page .ord-filter-panel__head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1rem 0.35rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #1d4ed8;
    }

    .ord-report-page .ord-filter-panel__head i {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        border-radius: 6px;
        font-size: 0.7rem;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .ord-report-page .ord-filter-panel__body {
        padding: 0 1rem 0.65rem;
    }

    .ord-report-page .ord-field-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.2rem;
    }

    .ord-report-page .ord-filter-panel .form-control,
    .ord-report-page .ord-filter-panel .select2-container--default .select2-selection--single {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        min-height: 30px;
        height: 30px;
        padding: 0.2rem 0.5rem;
        font-size: 0.8125rem;
    }

    .ord-report-page .ord-filter-panel .select2-container { width: 100% !important; }

    .ord-report-page .ord-filter-panel .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 26px;
        padding-left: 0;
        font-size: 0.8125rem;
        color: #1e293b;
    }

    .ord-report-page .ord-filter-panel .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 28px;
    }

    .ord-report-page .ord-filter-panel .select2-container--default.select2-container--focus .select2-selection--single,
    .ord-report-page .ord-filter-panel .select2-container--default.select2-container--open .select2-selection--single {
        border-color: var(--ord-primary);
        box-shadow: 0 0 0 2px rgba(var(--ord-primary-rgb), 0.1);
    }

    .ord-report-page .ord-filter-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
    }

    .ord-report-page .ord-btn-spacer {
        visibility: hidden;
        display: block;
        margin-bottom: 0.2rem;
        line-height: 1.7;
        font-size: 0.72rem;
    }

    .ord-report-page .ord-btn-show,
    .ord-report-page .ord-btn-dl {
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 6px;
        padding: 0.2rem 0.75rem;
        min-height: 30px;
        height: 30px;
        line-height: 1.2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .ord-report-page .ord-btn-show {
        background: linear-gradient(135deg, #2563eb 0%, #4f46e5 55%, #0891b2 100%);
        border: none;
        color: #fff;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .ord-report-page .ord-filter-panel .form-control:focus {
        border-color: var(--ord-primary);
        box-shadow: 0 0 0 2px rgba(var(--ord-primary-rgb), 0.1);
    }

    .ord-report-page .ord-btn-show:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
    }

    .ord-report-page .ord-btn-dl {
        background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
        border: none;
        color: #fff;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .ord-report-page .ord-btn-dl:hover:not(:disabled) {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.4);
    }

    .ord-report-page .ord-btn-dl:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .ord-report-page .ord-panel {
        background: var(--ord-surface);
        border: 1px solid var(--ord-border);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.75rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .ord-report-page .ord-panel__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
        padding-bottom: 0.45rem;
        border-bottom: 1px solid var(--ord-border);
    }

    .ord-report-page .ord-panel__title .ord-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.8);
    }

    .ord-report-page .ord-panel--summary { border-left: 4px solid #2563eb; }
    .ord-report-page .ord-panel--summary .ord-dot { background: linear-gradient(135deg, #2563eb, #4f46e5); }
    .ord-report-page .ord-panel--detail { border-left: 4px solid #2563eb; }
    .ord-report-page .ord-panel--detail .ord-dot { background: linear-gradient(135deg, #2563eb, #4f46e5); }

    .ord-report-page .ord-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .ord-report-page #ordKpiLinesSub {
        line-height: 1.45;
        white-space: normal;
    }

    @@media (max-width: 1199px) {
        .ord-report-page .ord-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 575px) {
        .ord-report-page .ord-kpi-grid { grid-template-columns: 1fr; }
    }

    .ord-report-page .ord-panel__title span {
        font-size: 0.9rem;
        font-weight: 800;
        color: #1e293b;
    }

    .ord-report-page .ord-grid-wrap {
        border: 2px solid rgba(37, 99, 235, 0.2);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
    }

    .ord-report-page .ord-grid-wrap .fixed-height-table {
        max-height: 460px;
    }

    .ord-report-page .ord-grid-wrap .paginator {
        background: linear-gradient(90deg, #eff6ff 0%, #eef2ff 50%, #ecfeff 100%);
        border-top: 1px solid var(--ord-border);
    }

    .ord-report-page .ord-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .ord-report-page .ord-status-badge--dispatched {
        background: #d1fae5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }

    .ord-report-page .ord-status-badge--partial {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fcd34d;
    }

    .ord-report-page .ord-status-badge--pending {
        background: #dbeafe;
        color: #1d4ed8;
        border: 1px solid #93c5fd;
    }

    .ord-report-page .ord-status-badge--cancelled {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
    }

    .ord-report-page #table-footer .ord-grid-total-row td {
        background: linear-gradient(90deg, #eff6ff 0%, #eef2ff 50%, #ecfeff 100%);
        border-top: 2px solid #2563eb;
        font-weight: 800;
        font-size: 0.8125rem;
        color: #1e293b;
        padding: 0.65rem 0.75rem;
        position: sticky;
        bottom: 0;
        z-index: 2;
    }

    .ord-report-page .ord-placeholder {
        background: linear-gradient(145deg, #fff 0%, #eff6ff 40%, #eef2ff 100%);
        border: 2px dashed rgba(37, 99, 235, 0.35);
        border-radius: 16px;
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

    .ord-report-page .ord-placeholder__icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #4f46e5, #0891b2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #fff;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
    }

    .ord-report-page .ord-placeholder h6 {
        font-weight: 800;
        background: linear-gradient(120deg, #1d4ed8, #0f766e);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.35rem;
    }

    .ord-report-page .ord-placeholder p {
        color: var(--ord-muted);
        font-size: 0.85rem;
        max-width: 460px;
        margin: 0 auto;
    }

    .ord-report-page #ordReportContent {
        display: none;
        animation: ordFadeIn 0.35s ease;
    }

    @@keyframes ordFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container-fluid ord-report-page esms-dash-webiz mt-1 pb-3">
    <div class="ord-filter-panel">
        <div class="ord-filter-panel__head">
            <i class="fa-solid fa-sliders"></i>
            Report filters
        </div>
        <div class="ord-filter-panel__body">
            <div class="row g-2">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="ord-field-label" for="txtFromDate">
                        From Date <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="txtFromDate" class="form-control form-control-sm box_border"
                           autocomplete="off" placeholder="DD/MM/YYYY">
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="ord-field-label" for="txtToDate">
                        To Date <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="txtToDate" class="form-control form-control-sm box_border"
                           autocomplete="off" placeholder="DD/MM/YYYY">
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="ord-field-label" for="ddlOrdClient">
                        Client
                    </label>
                    <select id="ddlOrdClient" class="form-control form-control-sm box_border" data-placeholder="All clients">
                        <option value="0">All clients</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-auto">
                    <label class="ord-field-label ord-btn-spacer" aria-hidden="true">&nbsp;</label>
                    <div class="ord-filter-actions">
                        <button type="button" class="btn ord-btn-show" id="btnOrdShow">
                            <i class="fa-solid fa-chart-column me-1"></i>Show
                        </button>
                        <button type="button" class="btn ord-btn-dl" id="btnOrdDownload" disabled>
                            <i class="fa-solid fa-file-excel me-1"></i>Download
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="ordReportContent">
        <div class="ord-panel ord-panel--summary">
            <div class="ord-panel__title">
                <span class="ord-dot"></span>
                <span>Order Summary</span>
            </div>
            <div class="ord-kpi-grid wd-kpi-grid">
                <div class="wd-kpi-premium wd-kpi-premium--blue">
                    <div class="wd-kpi-premium__icon"><i class="fa-solid fa-clipboard-list"></i></div>
                    <div>
                        <div class="wd-kpi-label">Lines</div>
                        <div class="wd-kpi-val" id="ordKpiLines">—</div>
                        <div class="wd-kpi-delta" id="ordKpiLinesSub"></div>
                    </div>
                </div>
                <div class="wd-kpi-premium wd-kpi-premium--green">
                    <div class="wd-kpi-premium__icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <div>
                        <div class="wd-kpi-label">Dispatch Qty</div>
                        <div class="wd-kpi-val" id="ordKpiQty">—</div>
                        <div class="wd-kpi-delta" id="ordKpiQtySub"></div>
                    </div>
                </div>
                <div class="wd-kpi-premium wd-kpi-premium--amber">
                    <div class="wd-kpi-premium__icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                    <div>
                        <div class="wd-kpi-label">MRP Deff</div>
                        <div class="wd-kpi-val" id="ordKpiAmount">—</div>
                        <div class="wd-kpi-delta" id="ordKpiAmountSub"></div>
                    </div>
                </div>
                <div class="wd-kpi-premium wd-kpi-premium--purple">
                    <div class="wd-kpi-premium__icon"><i class="fa-solid fa-users"></i></div>
                    <div>
                        <div class="wd-kpi-label">Clients</div>
                        <div class="wd-kpi-val" id="ordKpiClients">—</div>
                        <div class="wd-kpi-delta" id="ordKpiClientsSub"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ord-panel ord-panel--detail mb-0">
            <div class="ord-panel__title">
                <span class="ord-dot"></span>
                <span>Order Detail</span>
            </div>
            <div class="ord-grid-wrap" id="DataTable">
                <div class="table-wrapper fixed-height-table">
                    <table id="table" class="fixed-width-table table mb-0">
                        <thead id="table-header"></thead>
                        <tbody id="table-body"></tbody>
                        <tfoot id="table-footer"></tfoot>
                    </table>
                </div>
                <div class="paginator px-2 py-2" id="paginator-table"></div>
            </div>
        </div>
    </div>

    <div id="ordReportPlaceholder" class="ord-placeholder">
        <div class="ord-placeholder__icon">
            <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <h6>Ready to view orders</h6>
        <p>Choose <strong>From Date</strong>, <strong>To Date</strong>, and optional <strong>Client</strong>, then click <strong>Show</strong> to load order line detail.</p>
    </div>
</div>

<script src="~/assets/js/filter.js"></script>
<script src="~/assets/Script/OrderReport.js"></script>
