@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<link href="~/assets/css/esms-dashboard.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/js/xlsx.full.min.js"></script>

<style>
    .os-report-page {
        --os-primary: #033764;
        --os-primary-rgb: 3, 55, 100;
        --os-teal: #0d9488;
        --os-violet: #7c3aed;
        --os-rose: #e11d48;
        --os-amber: #d97706;
        --os-sky: #0284c7;
        --os-emerald: #059669;
        --os-surface: #ffffff;
        --os-muted: #64748b;
        --os-border: #e2e8f0;
        max-width: 1440px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 4px 2rem;
    }

    #layout-wrapper.esms-webiz .main-content:has(.os-report-page) {
        background: linear-gradient(160deg, #eef2ff 0%, #f0fdfa 35%, #fff7ed 70%, #f5f6fa 100%) !important;
        background-image: none !important;
    }

    /* ── Page intro ── */
    .os-report-page .os-page-intro {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .os-report-page .os-page-intro h5 {
        font-size: 1.15rem;
        font-weight: 800;
        margin: 0 0 0.25rem;
        background: linear-gradient(120deg, #033764 0%, #7c3aed 45%, #0d9488 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .os-report-page .os-page-intro p {
        font-size: 0.8rem;
        color: var(--os-muted);
        margin: 0;
    }

    .os-report-page .os-report-meta {
        font-size: 0.75rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
        border: none;
        border-radius: 20px;
        padding: 0.4rem 1rem;
        white-space: nowrap;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
    }

    /* ── Filter panel ── */
    .os-report-page .os-filter-panel {
        position: relative;
        background: var(--os-surface);
        border: 1px solid rgba(var(--os-primary-rgb), 0.12);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(var(--os-primary-rgb), 0.07);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .os-report-page .os-filter-panel::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, #06b6d4, #6366f1, #a855f7, #ec4899, #f59e0b);
    }

    .os-report-page .os-filter-panel__head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.1rem 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #4338ca;
    }

    .os-report-page .os-filter-panel__head i {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border-radius: 8px;
        font-size: 0.8rem;
        box-shadow: 0 3px 10px rgba(99, 102, 241, 0.35);
    }

    .os-report-page .os-filter-panel__body {
        padding: 0.65rem 1.1rem 1rem;
    }

    .os-report-page .os-field-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.2rem;
    }

    .os-report-page .os-filter-panel .form-control,
    .os-report-page .os-filter-panel .select2-container--default .select2-selection--single {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        min-height: 34px;
        font-size: 0.8125rem;
    }

    .os-report-page .os-filter-panel .select2-container { width: 100% !important; }

    .os-report-page .os-filter-panel .select2-container--default.select2-container--focus .select2-selection--single,
    .os-report-page .os-filter-panel .select2-container--default.select2-container--open .select2-selection--single {
        border-color: var(--os-primary);
        box-shadow: 0 0 0 3px rgba(var(--os-primary-rgb), 0.1);
    }

    .os-report-page .os-btn-show {
        background: linear-gradient(135deg, #059669 0%, #0d9488 50%, #0284c7 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        border-radius: 8px;
        padding: 0.4rem 1.25rem;
        min-height: 36px;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .os-report-page .os-btn-show:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(5, 150, 105, 0.45);
    }

    .os-report-page .os-btn-dl {
        background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        border-radius: 8px;
        min-height: 36px;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .os-report-page .os-btn-dl:hover:not(:disabled) {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(234, 88, 12, 0.45);
    }

    .os-report-page .os-btn-dl:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    /* ── Section panels ── */
    .os-report-page .os-panel {
        background: var(--os-surface);
        border: 1px solid var(--os-border);
        border-radius: 12px;
        padding: 1rem 1.15rem 1.1rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .os-report-page .os-panel__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--os-border);
    }

    .os-report-page .os-panel__title .os-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.8);
    }

    .os-report-page .os-panel--summary .os-dot { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
    .os-report-page .os-panel--ageing .os-dot { background: linear-gradient(135deg, #06b6d4, #0ea5e9); }
    .os-report-page .os-panel--trend .os-dot { background: linear-gradient(135deg, #10b981, #34d399); }
    .os-report-page .os-panel--collection .os-dot { background: linear-gradient(135deg, #f59e0b, #fb923c); }
    .os-report-page .os-panel--detail .os-dot { background: linear-gradient(135deg, #ec4899, #f472b6); }

    .os-report-page .os-panel--summary { border-left: 4px solid #8b5cf6; }
    .os-report-page .os-panel--ageing { border-left: 4px solid #06b6d4; }
    .os-report-page .os-panel--trend { border-left: 4px solid #10b981; }
    .os-report-page .os-panel--collection { border-left: 4px solid #f59e0b; }
    .os-report-page .os-panel--detail { border-left: 4px solid #ec4899; }

    .os-report-page .os-panel__title span {
        font-size: 0.9rem;
        font-weight: 800;
        color: #1e293b;
    }

    /* ── KPI cards ── */
    .os-report-page .os-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    @@media (max-width: 767px) {
        .os-report-page .os-kpi-grid { grid-template-columns: 1fr; }
    }

    .os-report-page .os-kpi {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        border: none;
        border-radius: 14px;
        padding: 1.1rem 1.15rem;
        color: #fff;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .os-report-page .os-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    }

    .os-report-page .os-kpi--total {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #a855f7 100%);
    }

    .os-report-page .os-kpi--delay {
        background: linear-gradient(135deg, #0284c7 0%, #06b6d4 50%, #22d3ee 100%);
    }

    .os-report-page .os-kpi--overdue {
        background: linear-gradient(135deg, #dc2626 0%, #e11d48 50%, #f43f5e 100%);
    }

    .os-report-page .os-kpi__icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.22);
        color: #fff;
        backdrop-filter: blur(4px);
    }

    .os-report-page .os-kpi-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.88);
        margin-bottom: 0.3rem;
    }

    .os-report-page .os-kpi-val {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
    }

    /* ── Chart cards ── */
    .os-report-page .os-chart-card {
        background: #fff;
        border: 1px solid var(--os-border);
        border-radius: 12px;
        height: 100%;
        min-height: 340px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }

    .os-report-page .os-chart-card:hover {
        box-shadow: 0 8px 24px rgba(var(--os-primary-rgb), 0.08);
    }

    .os-report-page .os-chart-card__head {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--os-border);
    }

    .os-report-page .os-chart-card__head h6 {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 800;
        color: #1e293b;
    }

    .os-report-page .os-chart-card__head h6 i {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        font-size: 0.75rem;
        color: #fff !important;
    }

    .os-report-page .os-chart-card--cyan .os-chart-card__head {
        background: linear-gradient(90deg, rgba(6, 182, 212, 0.15) 0%, #fff 70%);
    }
    .os-report-page .os-chart-card--cyan .os-chart-card__head h6 i {
        background: linear-gradient(135deg, #06b6d4, #0ea5e9);
    }

    .os-report-page .os-chart-card--violet .os-chart-card__head {
        background: linear-gradient(90deg, rgba(139, 92, 246, 0.15) 0%, #fff 70%);
    }
    .os-report-page .os-chart-card--violet .os-chart-card__head h6 i {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
    }

    .os-report-page .os-chart-card--emerald .os-chart-card__head {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.15) 0%, #fff 70%);
    }
    .os-report-page .os-chart-card--emerald .os-chart-card__head h6 i {
        background: linear-gradient(135deg, #059669, #10b981);
    }

    .os-report-page .os-chart-card--amber .os-chart-card__head {
        background: linear-gradient(90deg, rgba(245, 158, 11, 0.18) 0%, #fff 70%);
    }
    .os-report-page .os-chart-card--amber .os-chart-card__head h6 i {
        background: linear-gradient(135deg, #d97706, #f59e0b);
    }

    .os-report-page .os-chart-card--rose .os-chart-card__head {
        background: linear-gradient(90deg, rgba(244, 63, 94, 0.15) 0%, #fff 70%);
    }
    .os-report-page .os-chart-card--rose .os-chart-card__head h6 i {
        background: linear-gradient(135deg, #e11d48, #f43f5e);
    }

    .os-report-page .os-chart-body {
        flex: 1;
        min-height: 280px;
        padding: 0.35rem 0.5rem 0.5rem;
    }

    .os-report-page .os-empty-chart {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 280px;
        color: #94a3b8;
        font-size: 0.85rem;
        gap: 0.5rem;
    }

    /* ── Grid panel ── */
    .os-report-page .os-grid-wrap {
        border: 2px solid rgba(236, 72, 153, 0.25);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 16px rgba(236, 72, 153, 0.08);
    }

    .os-report-page .os-grid-wrap .fixed-height-table {
        max-height: 420px;
    }

    .os-report-page #table-footer .os-grid-total-row td {
        background: linear-gradient(90deg, #eef2ff 0%, #ecfdf5 50%, #fff7ed 100%);
        border-top: 2px solid #8b5cf6;
        font-weight: 800;
        font-size: 0.8125rem;
        color: #1e293b;
        padding: 0.65rem 0.75rem;
        position: sticky;
        bottom: 0;
        z-index: 2;
        box-shadow: 0 -4px 12px rgba(99, 102, 241, 0.08);
    }

    .os-report-page #table-footer .os-grid-total-row td.text-end {
        color: #4338ca;
        font-variant-numeric: tabular-nums;
    }

    .os-report-page .os-grid-wrap .paginator {
        background: linear-gradient(90deg, #fdf4ff 0%, #f0fdfa 50%, #eff6ff 100%);
        border-top: 1px solid var(--os-border);
    }

    /* ── Placeholder ── */
    .os-report-page .os-placeholder {
        background: linear-gradient(145deg, #fff 0%, #f5f3ff 40%, #ecfdf5 100%);
        border: 2px dashed rgba(99, 102, 241, 0.35);
        border-radius: 16px;
        padding: 3.5rem 1.5rem;
        text-align: center;
    }

    .os-report-page .os-placeholder__icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #a855f7, #ec4899);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #fff;
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
    }

    .os-report-page .os-placeholder h6 {
        font-weight: 800;
        background: linear-gradient(120deg, #4338ca, #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.35rem;
    }

    .os-report-page .os-placeholder p {
        color: var(--os-muted);
        font-size: 0.85rem;
        max-width: 360px;
        margin: 0 auto;
    }

    .os-report-page #osReportContent {
        display: none;
        animation: osFadeIn 0.35s ease;
    }

    @@keyframes osFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container-fluid os-report-page esms-dash-webiz mt-2 mt-md-3 pb-4">
    <div class="os-page-intro">
        <div>
            <h5>Bill Wise Outstanding</h5>
            <p>Analyse pending invoices, ageing buckets, and party-wise outstanding as on date.</p>
        </div>
        <span class="os-report-meta" id="osReportMeta">Select filters to load report</span>
    </div>

    <!-- Filters -->
    <div class="os-filter-panel">
        <div class="os-filter-panel__head">
            <i class="fa-solid fa-sliders"></i>
            Report filters
        </div>
        <div class="os-filter-panel__body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-4">
                    <label class="os-field-label" for="ddlOsParty">Party / Account</label>
                    <select id="ddlOsParty" class="form-control box_border" data-placeholder="All parties">
                        <option value="">All parties</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="os-field-label" for="txtOsAsonDate">
                        As on Date <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="txtOsAsonDate" class="form-control box_border"
                           autocomplete="off" placeholder="DD-MM-YYYY">
                </div>
                <div class="col-12 col-lg-5">
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <button type="button" class="btn os-btn-show px-4" id="btnOsShow">
                            <i class="fa-solid fa-chart-column me-2"></i>Show Report
                        </button>
                        <button type="button" class="btn os-btn-dl px-4" id="btnOsDownload" disabled>
                            <i class="fa-solid fa-file-excel me-2"></i>Download
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="osReportContent">
        <!-- KPI Summary -->
        <div class="os-panel os-panel--summary">
            <div class="os-panel__title">
                <span class="os-dot"></span>
                <span>Outstanding Summary</span>
            </div>
            <div class="os-kpi-grid">
                <div class="os-kpi os-kpi--total">
                    <div class="os-kpi__icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                    <div>
                        <div class="os-kpi-label">Total Outstanding</div>
                        <div class="os-kpi-val" id="osKpiTotal">—</div>
                    </div>
                </div>
                <div class="os-kpi os-kpi--delay">
                    <div class="os-kpi__icon"><i class="fa-solid fa-clock"></i></div>
                    <div>
                        <div class="os-kpi-label">Avg. Delay Days</div>
                        <div class="os-kpi-val" id="osKpiAvgDelay">—</div>
                    </div>
                </div>
                <div class="os-kpi os-kpi--overdue">
                    <div class="os-kpi__icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <div>
                        <div class="os-kpi-label">Overdue Amount</div>
                        <div class="os-kpi-val" id="osKpiOverdue">—</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ageing & Party Analysis -->
        <div class="os-panel os-panel--ageing">
            <div class="os-panel__title">
                <span class="os-dot"></span>
                <span>Ageing &amp; Party Analysis</span>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="os-chart-card os-chart-card--cyan">
                        <div class="os-chart-card__head">
                            <h6><i class="fa-solid fa-chart-column me-2"></i>Outstanding by Delay-Days Bucket</h6>
                        </div>
                        <div class="os-chart-body" id="chartOsAgeing"></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="os-chart-card os-chart-card--violet">
                        <div class="os-chart-card__head">
                            <h6><i class="fa-solid fa-building me-2"></i>Top 10 Parties by Outstanding</h6>
                        </div>
                        <div class="os-chart-body" id="chartOsTopParties"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Trend -->
        <div class="os-panel os-panel--trend">
            <div class="os-panel__title">
                <span class="os-dot"></span>
                <span>Monthly Trend</span>
            </div>
            <div class="os-chart-card os-chart-card--emerald">
                <div class="os-chart-card__head">
                    <h6><i class="fa-solid fa-chart-line me-2"></i>Month-wise Outstanding (by Invoice Date)</h6>
                </div>
                <div class="os-chart-body" id="chartOsMonthlyTrend"></div>
            </div>
        </div>

        <!-- Collection & Credit Analysis -->
        <div class="os-panel os-panel--collection">
            <div class="os-panel__title">
                <span class="os-dot"></span>
                <span>Collection &amp; Credit Analysis</span>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="os-chart-card os-chart-card--amber">
                        <div class="os-chart-card__head">
                            <h6><i class="fa-solid fa-scale-balanced me-2"></i>Top 10 — Amount vs Payment</h6>
                        </div>
                        <div class="os-chart-body" id="chartOsBilledCollected"></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="os-chart-card os-chart-card--rose">
                        <div class="os-chart-card__head">
                            <h6><i class="fa-solid fa-calendar-xmark me-2"></i>Top 10 — Beyond Credit Days</h6>
                        </div>
                        <div class="os-chart-body" id="chartOsCreditDelay"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail grid -->
        <div class="os-panel os-panel--detail mb-0">
            <div class="os-panel__title">
                <span class="os-dot"></span>
                <span>Bill-wise Outstanding Detail</span>
            </div>
            <div class="os-grid-wrap" id="osDetailTable">
                <div class="table-wrapper fixed-height-table">
                    <table id="table" class="fixed-width-table table mb-0">
                        <thead id="table-header"></thead>
                        <tbody id="table-body"></tbody>
                        <tfoot id="table-footer"></tfoot>
                    </table>
                </div>
                <div class="paginator" id="paginator-table"></div>
            </div>
        </div>
    </div>

    <div id="osReportPlaceholder" class="os-placeholder">
        <div class="os-placeholder__icon">
            <i class="fa-solid fa-chart-pie"></i>
        </div>
        <h6>Ready to analyse outstanding</h6>
        <p>Choose <strong>Party / Account</strong> and <strong>As on Date</strong>, then click <strong>Show Report</strong> to load charts and bill-wise detail.</p>
    </div>
