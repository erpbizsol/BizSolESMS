@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<style>
    .aai-grid-wrap {
        max-height: calc(100vh - 330px);
        min-height: 200px;
        overflow: auto;
    }
    .aai-grid-wrap table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f1f3f5;
        white-space: nowrap;
        font-size: 13px;
    }
    .aai-grid-wrap table tbody td {
        font-size: 13px;
        white-space: nowrap;
    }
    .aai-grid-wrap .aai-chk-col {
        width: 42px;
        text-align: center;
    }
    .aai-grid-wrap tr.aai-row-selected td {
        background: #e7f1ff;
    }
    .aai-grid-wrap tr.aai-row-selected td {
        box-shadow: inset 0 -2px 0 #0d6efd;
    }
    .aai-grid-wrap tr.aai-status-transfer td {
        background: #d4edda;
        color: #155724;
    }
    .aai-grid-wrap tr.aai-status-pending td {
        background: #f8d7da;
        color: #721c24;
    }
    .aai-right { text-align: right; }
    #aaiSelectedInfo { font-size: 13px; font-weight: 600; }
</style>

<div class="container webiz-aai-page">
    <div class="mt-2 mt-md-3">
        <div class="card border-0 shadow-sm mb-3 p-1">
            <div class="card-body pb-2">
                <div class="row g-3 align-items-start">
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtAaiFromDate" class="form-label form-label-sm mb-1 fw-semibold">From Date</label>
                        <input type="text" id="txtAaiFromDate" class="form-control form-control-sm box_border" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtAaiToDate" class="form-label form-label-sm mb-1 fw-semibold">To Date</label>
                        <input type="text" id="txtAaiToDate" class="form-control form-control-sm box_border" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="ddlAaiTemplate" class="form-label form-label-sm mb-1 fw-semibold">Template <span class="text-danger">*</span></label>
                        <select id="ddlAaiTemplate" class="form-control form-control-sm box_border">
                            <option value="">Select Template</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-auto d-flex flex-column">
                        <label class="form-label form-label-sm mb-1 fw-semibold invisible text-nowrap" aria-hidden="true">Action</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary btn-height px-3" id="btnAaiShow">Show</button>
                            <button type="button" class="btn btn-secondary btn-height px-3" id="btnAaiReset">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" id="aaiGridCard" style="display:none;">
            <div class="card-body p-0">
                <div class="d-flex flex-wrap justify-content-between align-items-center px-3 py-2 border-bottom">
                    <span id="aaiTemplateTitle" class="fw-semibold"></span>
                    <span id="aaiSelectedInfo" class="text-primary">Selected : 0 / 0</span>
                    <button type="button" class="btn btn-success btn-sm px-3" id="btnAaiSync">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Send to Application
                    </button>
                </div>
                <div class="aai-grid-wrap">
                    <table id="tblAai" class="table table-sm table-hover table-bordered mb-0">
                        <thead id="aaiHead"></thead>
                        <tbody id="aaiBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>
    <div id="toast" class="toast-container"></div>
</div>

<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/js/AccountAppIntegration.js"></script>
