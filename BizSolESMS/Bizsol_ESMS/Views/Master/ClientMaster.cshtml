<style>
    /* Brand multi-select */
    .brand-ms-wrap {
        position: relative;
    }

    .brand-ms {
        position: relative;
        width: 100%;
    }

    .brand-ms-trigger {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.3rem;
        min-height: 1.72rem;
        padding: 0.2rem 1.75rem 0.2rem 0.45rem;
        border: 1px solid #64748b;
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        position: relative;
        text-align: left;
    }

    .brand-ms-trigger:hover:not(.is-disabled) {
        border-color: #475569;
    }

    .brand-ms-trigger.is-open,
    .brand-ms-trigger:focus-visible {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        outline: none;
    }

    .brand-ms-trigger.is-disabled {
        background: #f1f5f9;
        cursor: not-allowed;
        opacity: 0.85;
    }

    .brand-ms-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        flex: 1;
        min-width: 0;
    }

    .brand-ms-chips:empty {
        display: none;
    }

    .brand-ms-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        max-width: 100%;
        padding: 0.1rem 0.35rem;
        border-radius: 999px;
        background: #e8eef6;
        color: #1d4b7d;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .brand-ms-chip-readonly {
        padding-right: 0.45rem;
    }

    .brand-ms-chip-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .brand-ms-chip-remove {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #64748b;
        font-size: 0.85rem;
        line-height: 1;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .brand-ms-chip-remove:hover {
        background: rgba(29, 75, 125, 0.12);
        color: #1d4b7d;
    }

    .brand-ms-placeholder {
        color: #64748b;
        font-size: 0.8125rem;
        font-weight: 400;
        line-height: 1.35;
        user-select: none;
        text-align: left;
        flex: 1;
    }

    .brand-ms-chevron {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 0.65rem;
        pointer-events: none;
        transition: transform 0.2s ease, color 0.15s ease;
    }

    .brand-ms-trigger.is-open .brand-ms-chevron {
        transform: translateY(-50%) rotate(180deg);
        color: #1d4b7d;
    }

    .brand-ms-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 1050;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
        overflow: hidden;
    }

    .brand-ms-dropdown.is-open {
        display: block;
    }

    .brand-ms-search-wrap {
        position: relative;
        padding: 0.45rem 0.5rem 0.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .brand-ms-search-icon {
        position: absolute;
        left: 0.95rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.72rem;
        pointer-events: none;
    }

    .brand-ms-search {
        width: 100%;
        padding: 0.28rem 0.5rem 0.28rem 1.65rem;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        font-size: 0.78rem;
        color: #1e293b;
        background: #fff;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .brand-ms-search:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.15);
    }

    .brand-ms-select-all {
        padding: 0.2rem 0.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
    }

    .brand-ms-options {
        max-height: 180px;
        overflow-y: auto;
        padding: 0.25rem 0.35rem 0.35rem;
    }

    .brand-ms-option {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0.38rem 0.45rem;
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.12s ease;
        user-select: none;
    }

    .brand-ms-option:hover {
        background: #f1f5f9;
    }

    .brand-ms-option:has(.option:checked) {
        background: #eef2ff;
    }

    .brand-ms-select-all-item {
        font-weight: 600;
        color: #1e293b;
    }

    .brand-ms-checkbox {
        width: 0.95rem;
        height: 0.95rem;
        margin: 0;
        accent-color: #1d4b7d;
        flex-shrink: 0;
        cursor: pointer;
    }

    .brand-ms-option-text {
        font-size: 0.8125rem;
        font-weight: 500;
        color: #334155;
        line-height: 1.3;
    }

    .brand-ms-empty {
        padding: 0.75rem 0.5rem;
        text-align: center;
        color: #94a3b8;
        font-size: 0.78rem;
    }

    th, .filter-table-heading {
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .filter-table-heading {
        overflow: hidden;
    }

    .table th {
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .table-filter-arrow {
        position: relative;
        display: inline-block;
    }

    .tabs {
        width: 100%;
        max-width: 2000px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
        border-radius: 8px;
        overflow: hidden;
        padding: 0.7rem;
    }

    .tabSec {
        color: white;
        width: 117px;
        height: 36px;
        float: inline-end;
        font-size: 12px;
        text-align: center;
        border-top-right-radius: 40px;
        border-bottom-left-radius: 40px;
        line-height: 3;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
        margin-top: -8px;
        background: #1d4b7d;
    }

    .tab-content {
        display: none;
        padding: 16px;
        border: 1px solid lightgray;
        border-radius: 5px;
    }

        .tab-content.active {
            display: block;
        }

    .tab[disabled] {
        cursor: not-allowed;
        opacity: 0.9;
    }

    .datepicker td, .datepicker th {
        border-radius: 20px !important;
    }

    .datepicker table tr td, .datepicker table tr td {
        padding: 8px 9px !important;
        height: 16px !important;
    }

    .datepicker table tfoot {
        display: none;
    }

    .page-content {
        display: block;
    }

    .textCreatepage .tabs .fix-header {
        position: sticky;
        top: 0;
        background-color: #dddde4;
        z-index: 1000;
        padding: 8px 0 8px 9px;
        transition: background 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.9);
        height: 36px;
    }

    .shadow-sm {
        border-top-right-radius: 5px;
        border-top-left-radius: 5px;
        background-color: #e9e9ef;
        margin-top: 15px;
        border-top: 1px solid #c9cae7;
    }

    .btn-icon {
        font-size: 14px;
        border-radius: 50%;
        background: #1d4b7d;
        color: #fff;
        padding: 6px;
    }

    .btn-icon {
        font-size: 14px;
        border-radius: 20px;
        background: #1d4b7d;
        color: #fff;
        padding: 6px;
    }

    .btn-danger {
        background-color: #ab1624;
    }

    .highlight {
        background-color: #f5c0bfc4;
    }

    .container-fluid {
        padding-right: 0;
        padding-left: 0;
    }

    .container {
        overflow: auto;
        height: 81vh;
    }

    .breadcrumbs1 {
        background: #dddde4;
        position: sticky;
        top: 0;
        background-color: #dddde4;
        z-index: 1000;
        padding: 8px 0px 0px 9px;
        box-shadow: 0 2px 4px rgb(96 95 95 / 90%);
        box-shadow: 0 1px 1px rgb(76 76 76 / 90%);
    }

    .page-content {
        padding: 3px 0;
    }
</style>
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtsave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
