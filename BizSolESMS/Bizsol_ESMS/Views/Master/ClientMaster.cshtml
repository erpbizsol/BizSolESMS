                                    <input type="hidden" id="dropdownButton" value="" />
                                    <div class="brand-ms-trigger select-checkbox-multi" id="brandMultiTrigger" tabindex="0" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-label="Select brands">
