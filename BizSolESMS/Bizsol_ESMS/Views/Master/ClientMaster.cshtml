                                        <div class="brand-ms-search-wrap">
                                            <i class="fa-solid fa-magnifying-glass brand-ms-search-icon"></i>
                                            <input type="text" class="brand-ms-search" id="brandSearchInput" placeholder="Search brands..." autocomplete="off" />
                                        </div>
                                        <div class="brand-ms-select-all">
                                            <label class="brand-ms-option brand-ms-select-all-item">
                                                <input type="checkbox" id="selectAll" class="brand-ms-checkbox" />
