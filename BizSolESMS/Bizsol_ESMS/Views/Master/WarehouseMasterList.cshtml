@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/assets/script/warehouse.js"></script>
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtbtnSave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <div class="sm-table mt-3" id="txtListpage">
    <div class="row">
        <div class="col-sm-12 text-end">
            <label></label>
             <button type="button" class="btn btn-primary btn-height" title="DOWNLOAD" onclick="DataExport()">DOWNLOAD</button>
            <button type="button" class="btn btn-success btn-height" title="CREATE NEW" onclick="CreateWarehouseMaster()">CREATE NEW</button>
        </div>
    </div>
    <div class="card-body mt-2" id="txtwarehousetable">
        <div class="table-wrapper fixed-height-table">
            <table id="table" class="fixed-width-table table">
                <thead id="table-header">
                </thead>
                <tbody id="table-body">
                </tbody>
            </table>
        </div>
        <!-- Paginator -->
        <div class="paginator" id="paginator-table">
        </div>
    </div>
</div>
<div id="txtCreatepage" style="display:none;">
    <div class="card shadow-sm" style="background-color:#e9e9ef">
        <div class="tabs">
            <div class="row p-1">
                <div class="col-md-12">
                    <input type="hidden" value="0" id="hftxtCode" />
                    <input type="text" id="txtWarehouseType" name="txtWarehouseType" class="d-none" autocomplete="off" />
                    <input type="text" id="txtGSTIN" name="txtGSTIN" class="d-none" autocomplete="off" />
                    <div class="row">
                        <div class="col-md-3">
                            <label for="txtWarehouseName" class="col-form-label-sm fw-bold">
                                Warehouse Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="txtWarehouseName" name="txtWarehouseName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Warehouse Name" maxlength="50">
                        </div>
                        <div class="col-md-3">
                            <label for="txtDisplayName" class="col-form-label-sm fw-bold">Display Name</label>
                            <input type="text" id="txtDisplayName" name="txtDisplayName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Display Name" maxlength="225">
                        </div>
                        <div class="col-md-3">
                            <label for="txtCity" class="col-form-label-sm fw-bold">
                                City <span class="text-danger">*</span>
                            </label>
                            <input list="txtCityList" id="txtCity" name="txtCity" autocomplete="off" onchange="OnWarehouseCityChanged(this);" class="form-control form-control-sm box_border" placeholder="City">
                        </div>
                        <div class="col-md-3">
                            <label for="txtState" class="col-form-label-sm fw-bold">State</label>
                            <input list="txtStateNameList" id="txtState" name="txtState" autocomplete="off" class="form-control form-control-sm box_border" placeholder="State" disabled>
                        </div>
                    </div>
                    <div class="row mt-1">
                        <div class="col-md-3">
                            <label for="txtPin" class="col-form-label-sm fw-bold">Pin</label>
                            <input type="text" id="txtPin" name="txtPin" autocomplete="off" class="Number form-control form-control-sm box_border" placeholder="Pin" maxlength="6" disabled>
                        </div>
                        <div class="col-md-3">
                            <label for="txtAddressLine1" class="col-form-label-sm fw-bold">
                                Address Line 1 <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="txtAddressLine1" name="txtAddressLine1" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Address Line 1" maxlength="225">
                        </div>
                        <div class="col-md-3">
                            <label for="txtAddressLine2" class="col-form-label-sm fw-bold">Address Line 2</label>
                            <input type="text" id="txtAddressLine2" name="txtAddressLine2" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Address Line 2" maxlength="225">
                        </div>
                        <div class="col-md-3">
                            <label for="txtDefaultWarehouse" class="col-form-label-sm d-block">&nbsp;</label>
                            <input type="checkbox" id="txtDefaultWarehouse" name="txtDefaultWarehouse" class="box_border" checked />
                            <label for="txtDefaultWarehouse">Default Warehouse</label>
                        </div>
                    </div>
                </div>
            </div>
          @*   <div class="row m-2">
                <div class="col-md-12" style="margin-top: 30px !important;">
                    <button class="btn btn-primary btn-height" title="Save" onclick="Save()" id="txtbtnSave">Save</button>
                    <button class="btn btn-danger btn-height" title="Back" onclick="BackMaster()">Back</button>
                </div>
            </div> *@
        </div>
    </div>
</div>
</div>
<datalist id="txtStateNameList"></datalist>
<datalist id="txtCityList"></datalist>
<script src="~/assets/js/filter.js"></script>


