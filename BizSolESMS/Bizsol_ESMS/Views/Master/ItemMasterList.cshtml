@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="~/assets/script/itemmaster.js"></script>
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtsave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                        @* <a class="btn-icon me-1" id="btnBack" onclick="Report()" title="Report"><i class="fa fa-download" aria-hidden="true"></i></a> *@
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <div class=" mt-3" id="txtListpage" style="display:block;">
        <div class="row">
            <div class="col-sm-12 text-end">
                <label></label>
                <button type="button" class="btn btn-primary btn-height" title="DOWNLOAD" onclick="DataExport()">DOWNLOAD</button>
                <button type="button" class="btn btn-success btn-height" title="CREATE NEW" onclick="CreateItemMaster()">CREATE NEW</button>
            </div>
        </div>
        <div class="card-body mt-3" id="txtitemtable">
            <div class="table-wrapper fixed-height-table">
                <table id="table" class="fixed-width-table table">
                    <thead id="table-header">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
            <!-- Paginator -->
            <div class="paginator" id="paginator-table">
            </div>
        </div>
    </div>
    <div id="txtCreatepage" class="esms-item-master-page" style="display:none;">
        <div class="esms-item-master-card">
            <div class="esms-item-master-card__body">
                <div class="row g-2">
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtBrand" class="col-form-label-sm fw-bold">Brand</label>
                        <datalist id="txtBrandList"></datalist>
                        <input list="txtBrandList" id="txtBrand" name="txtBrand" autocomplete="off"
                               class="form-control form-control-sm box_border" placeholder="Brand Name">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtItemCode" class="col-form-label-sm fw-bold" id="txtItemCodelab">Item Code</label><span class="text-danger">*</span>
                        <input type="text" id="txtItemCode" class="box_border form-control form-control-sm" oninput="convertToUppercase(this)" autocomplete="off" maxlength="16" placeholder="Item Code">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtItemName" class="col-form-label-sm fw-bold" id="txtItemNamelab">Item Name</label><span class="text-danger">*</span>
                        <input type="hidden" id="hfCode" value="0">
                        <input type="text" id="txtItemName" oninput="updateDisplayName()" class="box_border form-control form-control-sm" autocomplete="off" maxlength="200" placeholder="Item Name">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtDisplayName" class="col-form-label-sm fw-bold">Display Name</label><span class="text-danger">*</span>
                        <input type="text" id="txtDisplayName" class="box_border form-control form-control-sm" autocomplete="off" maxlength="128" placeholder="Display Name">
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtItembarcode" class="col-form-label-sm fw-bold" id="txtItembarcodelab">Item Bar Code</label>
                        <input type="text" id="txtItembarcode" class="box_border form-control form-control-sm" autocomplete="off" maxlength="20" placeholder="Item Bar Code" required>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtUOM" class="col-form-label-sm fw-bold">UOM</label><span class="text-danger">*</span>
                        <datalist id="txtUOMList"></datalist>
                        <input list="txtUOMList" id="txtUOM" name="txtUOM" autocomplete="off" class="form-control form-control-sm box_border" placeholder="UOM Name">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtHSNCode" class="col-form-label-sm fw-bold">HSN Code</label>
                        <input type="text" id="txtHSNCode" name="txtHSNCode" class="box_border form-control form-control-sm" autocomplete="off" maxlength="8" placeholder="HSN Code" />
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtCategory" class="col-form-label-sm fw-bold">Category</label>
                        <datalist id="txtCategoryList"></datalist>
                        <input list="txtCategoryList" id="txtCategory" name="txtCategory" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Category Name">
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtGroupItem" class="col-form-label-sm fw-bold" id="GroupItemHeaderlab">Group Item</label>
                        <datalist id="txtGroupItemList"></datalist>
                        <input list="txtGroupItemList" id="txtGroupItem" name="txtGroupItem" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Group Item">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtSubGroupItem" class="col-form-label-sm fw-bold" id="SubGroupItemHeaderlab">Sub Group Item</label>
                        <datalist id="txtSubGroupItemList"></datalist>
                        <input list="txtSubGroupItemList" id="txtSubGroupItem" name="txtSubGroupItem" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Sub Group Item">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group">
                        <label for="txtReorderLevel" class="col-form-label-sm fw-bold">Reorder Level</label>
                        <input type="text" id="txtReorderLevel" class="Number box_border form-control form-control-sm" autocomplete="off" maxlength="10" placeholder="Reorder Level" value="0">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group d-none">
                        <label for="txtReorderQty" class="col-form-label-sm fw-bold">Reorder Qty</label>
                        <input type="text" id="txtReorderQty" class="Number box_border form-control form-control-sm" autocomplete="off" maxlength="10" placeholder="Reorder Qty" value="0">
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group" id="divItemLocationField">
                        <label for="txtItemLocation" class="col-form-label-sm fw-bold" id="SubLocationItemHeaderlab">Location Item</label><span class="text-danger">*</span>
                        <select id="txtItemLocation" name="txtItemLocation" class="form-control form-control-sm box_border" multiple></select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3 esms-field-group" id="txtMRPDiV">
                        <label for="txtMRP" class="col-form-label-sm fw-bold">MRP</label>
                        <input type="text" id="txtMRP" name="txtMRP" class="Number box_border form-control form-control-sm" autocomplete="off" maxlength="10" placeholder="MRP" value="0" />
                    </div>
                </div>
                <div class="row g-2 esms-item-master-checks align-items-end">
                    <div class="col-6 col-sm-4 col-lg-2 esms-field-group esms-check-field">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="txtBoxPacking" name="txtBoxPacking" class="form-check-input box_border" onchange="updateQtyBox(this.value)" />
                            <label for="txtBoxPacking" class="form-check-label">Box Packing</label>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-2 esms-field-group">
                        <label for="txtQtyinBox" class="col-form-label-sm fw-bold">Qty in Box</label>
                        <input type="text" id="txtQtyinBox" class="Number box_border form-control form-control-sm" autocomplete="off" maxlength="10" placeholder="Qty in Box" value="0" disabled>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2 esms-field-group esms-check-field">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="txtBatchApplicable" name="txtBatchApplicable" class="form-check-input box_border" checked />
                            <label for="txtBatchApplicable" class="form-check-label">Batch Applicable</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2 esms-field-group esms-check-field">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="txtMaintainExpiry" name="txtMaintainExpiry" class="form-check-input box_border" checked />
                            <label for="txtMaintainExpiry" class="form-check-label">Maintain Expiry</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2 esms-field-group esms-check-field">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="txtIsActive" name="txtIsActive" class="form-check-input box_border" checked />
                            <label for="txtIsActive" class="form-check-label">Is Active</label>
                        </div>
                    </div>
                </div>

                <div class="row mt-2" id="divItemWarehouseGrid" style="display:none;">
                    <div class="col-12">
                        <div class="esms-item-warehouse-card">
                            <div class="esms-item-warehouse-card__header">
                                <div>
                                    <h6 class="esms-item-warehouse-card__title">
                                        <i class="fa-solid fa-warehouse me-2"></i>Warehouse &amp; Bin Location
                                    </h6>
                                    <p class="esms-item-warehouse-card__subtitle">Select warehouse first, then search and pick the bin location.</p>
                                </div>
                            </div>
                            <div class="esms-item-warehouse-card__body">
                                <div class="table-responsive esms-item-warehouse-table-wrap">
                                    <table id="tblItemWarehouseLocation" class="table esms-item-warehouse-table mb-0">
                                        <thead>
                                            <tr>
                                                <th class="col-sno">S.No</th>
                                                <th class="col-warehouse">Warehouse Name<span class="text-danger">*</span></th>
                                                <th class="col-location">Location Name<span class="text-danger">*</span></th>
                                                <th class="col-action">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbItemWarehouseLocation"></tbody>
                                    </table>
                                </div>
                                <div class="esms-item-warehouse-card__footer">
                                    <button type="button" id="btnAddItemWarehouseRow" class="btn btn-sm esms-btn-add-row">
                                        <i class="fa-solid fa-plus me-1"></i>Add New Row
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="LocationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content mt-5" style="max-width: 400px;">
            <div class="modal-header">
                <h5 class="modal-title">Create Location (Bin)</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="ClearLocationData()" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                        <div class="col-md-12 col-12">
                        <select id="mySelect2" class="form-control form-control-sm box_border" multiple style="width: 300px;" placeholder="Select locations..">
                        </select>
                    </div>
                </div>
                <div class="row d-none" id="divLocationModalWarehouse">
                    <div class="col-md-12 col-12 pt-2">
                        <label for="ddlLocationModalWarehouse" class="col-form-label-sm fw-bold mb-1">Warehouse <span class="text-danger">*</span></label>
                        <select id="ddlLocationModalWarehouse" class="form-control form-control-sm box_border"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-5 col-12 pt-2">
                        <input type="text" id="txtLocationName" name="txtLocationName" class="box_border form-control mb-0 form-control-sm" value="" autocomplete="off" placeholder="Create new location..." />
                        <input type="hidden" id="hfItemCode" name="hfItemCode" class="box_border form-control form-control-sm mb-0" value="0" autocomplete="off" />
                    </div>
                    <div class="col-md-7 col-12 pt-2">
                        <button type="button" title="Create new location" class="btn btn-info btn-height" id="btnCreateNew">Create</button>
                        <button type="button" title="Save" class="btn btn-success btn-height" id="btnSaveLocation">Save</button>&nbsp;
                        <button type="button" title="Close" class="btn btn-danger btn-height" aria-label="Close" onclick="ClearLocationData()" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/filter.js"></script>

