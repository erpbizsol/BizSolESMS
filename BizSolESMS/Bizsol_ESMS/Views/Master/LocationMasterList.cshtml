@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/script/locationmaster.js"></script>
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtsave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="breadcrumbs1" id="txtheaderdiv2" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" id="btnLocationImportSave" onclick="SaveLocationImportFile()" title="Save Import"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnLocationImportBack" onclick="BackLocationImport()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tabLocationImport" class="tabSec tab active">IMPORT</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
<div class="sm-table mt-3" id="txtListpage">
    <div class="row">
        <div class="col-sm-12 text-end">
            <label></label>
                <button type="button" class="btn btn-primary btn-height" title="DOWNLOAD" id="exportExcel" onclick="DataExport()">DOWNLOAD</button>
            <button type="button" class="btn btn-info btn-height" title="IMPORT" id="btnImportLocation" onclick="ImportLocationExcel()">IMPORT</button>
            <button type="button" class="btn btn-success btn-height" title="CREATE NEW" onclick="Create()">CREATE NEW</button>
        </div>
    </div>
    <div class="card-body mt-2" id="txtlocationtable">
        <div class="table-wrapper fixed-height-table">
            <table id="table" class="fixed-width-table table">
                <thead id="table-header">
                </thead>
                <tbody id="table-body">
                </tbody>
            </table>
        </div>
        <!-- Paginator -->
        <div class="paginator" id="paginator-table">
        </div>
    </div>
</div>
<div id="txtCreatepage" style="display:none;">
    <div class="card shadow-sm" style="background-color:#e9e9ef">
        <div class="tabs">
            <div class="row p-1">
                <div class="col-md-12">
                    <div class="row">
                            <div class="col-md-3  col-sm-6">
                                <label for="txtLocationGroup" class="col-form-label-sm fw-bold">
                                    Location Group
                                </label>
                                <input type="text" id="txtLocationGroup" name="txtLocationGroup" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Location Group" maxlength="50">
                            </div>
                            <div class="col-md-3  col-sm-6">
                                <label for="txtLocation" class="col-form-label-sm fw-bold">
                                    Location <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtLocation" name="txtLocation" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Location" maxlength="50">
                            </div>
                        <div class="col-md-3  col-sm-6">
                            <label for="txtLocationName" class="col-form-label-sm fw-bold">
                                Location Name <span class="text-danger">*</span>
                            </label>
                            <input type="hidden" id="hftxtCode" value="0" />
                            <input type="text" id="txtLocationName" name="txtLocationName" autocomplete="off" class="form-control form-control-sm box_border bg-light" placeholder="Filled from Group + Location" maxlength="50" disabled>
                        </div>
                        @* <div class="col-md-3  col-sm-6 tex-end" style="margin-top: 30px !important;">
                            <button class="btn btn-primary btn-height" title="Save" onclick="Save()" id="txtsave">Save</button>
                            <button class="btn btn-danger btn-height" title="Back" onclick="BackMaster()">Back</button>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="textCreatepage" id="txtLocationImportPage" style="display:none;">
    <div class="card shadow-sm" style="background-color:#e9e9ef">
        <div class="tabs">
            <div class="row p-2">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-3 col-sm-6">
                            <label for="txtLocationExcelFile" class="col-form-label-sm fw-bold">Choose File</label><span class="text-danger">*</span>
                            <input type="file" id="txtLocationExcelFile" class="box_border form-control form-control-sm" autocomplete="off" accept=".xlsx, .xls, .csv">
                        </div>
                        <div class="col-md-3 col-sm-6">
                                <button type="button" style="margin-top: 36px;" class="btn btn-secondary btn-height" onclick="DownloadLocationImportTemplate();">
                                    Download Template
                                </button>
                        </div>
                        <div class="col-12 mt-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="chkInsertNewItem" checked>
                                <label class="form-check-label" for="chkInsertNewItem">Insert new item (if missing)</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="chkInsertNewLocation" checked>
                                <label class="form-check-label" for="chkInsertNewLocation">Insert new location (if missing)</label>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Use the same columns as the template: <strong>Part #</strong>, <strong>Description</strong>, <strong>Qty</strong>, <strong>PG</strong> (product/location group), <strong>Location</strong>. <strong>PG</strong> maps to Location Group; Location Name on bin master can still be derived as PG + Location where needed.</small>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body mt-2" id="LocationImportTable" style="display:none;">
        <div class="table-wrapper fixed-height-table">
            <table id="tableLocationImport" class="fixed-width-table table">
                <thead id="table-header-location-import">
                </thead>
                <tbody id="table-body-location-import">
                </tbody>
            </table>
        </div>
        <div class="paginator" id="paginator-tableLocationImport">
        </div>
    </div>
</div>
</div>
<script src="~/assets/js/filter.js"></script>


