@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<link href="~/assets/css/loader.css" rel="stylesheet" />

<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtbtnSave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <div class="table mt-3" id="txtListpage">
        <div class="row">
            <div class="col-sm-12 text-end">
                <label></label>
                <button type="button" class="btn btn-primary btn-height" title="DOWNLOAD" onclick="DataExport()">DOWNLOAD</button>
                <button type="button" class="btn btn-success btn-height" title="CREATE NEW" onclick="CreateRetailerReplacementIn()">CREATE NEW</button>
            </div>
        </div>
        <div class="card-body mt-2" id="txtVendorReplacementTable">
            <div class="table-wrapper fixed-height-table">
                <table id="table" class="fixed-width-table table">
                    <thead id="table-header">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-table">
            </div>
        </div>
    </div>
    <div id="txtCreatepage" style="display:none;">
        <div class="card shadow-sm" style="background-color:#e9e9ef">
            <div class="tabs">
                <div class="row p-2">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <label for="txtEntryNo" class="col-form-label-sm fw-bold">Entry No</label>
                                <input type="hidden" value="0" id="hfCode" />
                                <input type="text" id="txtEntryNo" name="txtEntryNo" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Auto Generated" disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtEntryDate" class="col-form-label-sm fw-bold">Entry Date <span class="text-danger">*</span></label>
                                <input type="date" id="txtEntryDate" name="txtEntryDate" autocomplete="off" class="form-control form-control-sm box_border">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtRetailerName" class="col-form-label-sm fw-bold">Retailer Name <span class="text-danger">*</span></label>
                                <select id="txtRetailerName" name="txtRetailerName" class="form-control form-control-sm box_border">
                                    <option value="">Select</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtHead" class="col-form-label-sm fw-bold">Head <span class="text-danger">*</span></label>
                                <select id="txtHead" name="txtHead" class="form-control form-control-sm box_border">
                                    <option value="">Select</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtRemark" class="col-form-label-sm fw-bold">Remark</label>
                                <input type="text" id="txtRemark" name="txtRemark" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Remark" maxlength="200">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-wrapper fixed-height-table" style="overflow:auto;">
                            <table id="tblVendorReplacement" class="table fixed-width-table">
                                <thead class="text-sm-center">
                                    <tr>
                                        <th id="thItemBarCode" style="min-width:160px;">Part Bar Code <span class="text-danger">*</span></th>
                                        <th id="thItemCode" style="min-width:180px;">Item Code <span class="text-danger">*</span></th>
                                        <th id="thItemName" style="min-width:260px;">Item Name <span class="text-danger">*</span></th>
                                        <th id="thQty" style="width:70px;min-width:70px;max-width:80px;">Qty <span class="text-danger">*</span></th>
                                        <th style="width:80px;">Delete</th>
                                    </tr>
                                </thead>
                                <tbody id="VendorReplacementData"></tbody>
                                <tfoot>
                                    <tr id="trAddBtn">
                                        <td style="text-align:left;">
                                            <input id="btnAddNewRow" type="button" class="btn btn-primary btn-sm" value="Add New Row" />
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <datalist id="txtItemBarCodeList"></datalist>
                <datalist id="txtItemCodeList"></datalist>
                <datalist id="txtItemNameList"></datalist>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/filter.js"></script>
<script src="~/assets/script/RetailerReplacementIn.js"></script>
