@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/assets/script/bankmaster.js"></script>

<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="form-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="Save()" id="txtbtnSave" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <div class="lg-table mt-3" id="txtListpage">
        <div class="row">
            <div class="col-sm-12 text-end">
                <label></label>
                <button type="button" class="btn btn-primary btn-height" title="DOWNLOAD" onclick="DataExport()">DOWNLOAD</button>
                <button type="button" class="btn btn-success btn-height" title="CREATE NEW" onclick="CreateBankMaster()">CREATE NEW</button>
            </div>
        </div>
        <div class="card-body mt-2" id="txtbanktable">
            <div class="table-wrapper fixed-height-table">
                <table id="table" class="fixed-width-table table">
                    <thead id="table-header">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
            <!-- Paginator -->
            <div class="paginator" id="paginator-table">
            </div>
        </div>
    </div>
    <div id="txtCreatepage" style="display:none;">
        <div class="card shadow-sm" style="background-color:#e9e9ef">
            <div class="tabs">
                <div class="row p-1">
                    <div class="col-md-12">
                        <div class="row">
                            <input type="hidden" value="0" id="hftxtCode" />
                            <div class="col-md-3 col-sm-6">
                                <label for="txtBankName" class="col-form-label-sm fw-bold">
                                    Bank Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtBankName" name="txtBankName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Bank Name" maxlength="100">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtAccountNo" class="col-form-label-sm fw-bold">
                                    Account No. <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtAccountNo" name="txtAccountNo" autocomplete="off" oninput="OnlyNumeric(this);" class="form-control form-control-sm box_border" placeholder="Account No." maxlength="30" inputmode="numeric">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtIFSCCode" class="col-form-label-sm fw-bold">
                                    IFSC Code <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtIFSCCode" name="txtIFSCCode" autocomplete="off" oninput="convertToUppercase(this);" class="form-control form-control-sm box_border" placeholder="IFSC Code" maxlength="11">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtBranch" class="col-form-label-sm fw-bold">
                                    Branch <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtBranch" name="txtBranch" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Branch" maxlength="100">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="ddlType" class="col-form-label-sm fw-bold">
                                    Type <span class="text-danger">*</span>
                                </label>
                                <select id="ddlType" name="ddlType" class="form-control form-control-sm box_border">
                                    <option value="">Select Type</option>
                                    <option value="Saving">Saving</option>
                                    <option value="Current">Current</option>
                                    <option value="CC">CC</option>
                                    <option value="OD">OD</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6" style="margin-top:34px;">
                                <input type="checkbox" id="txtDefaultCheck" name="txtDefaultCheck" class="box_border" />
                                <label for="txtDefaultCheck" class="col-form-label-sm fw-bold">Default Check</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/filter.js"></script>
