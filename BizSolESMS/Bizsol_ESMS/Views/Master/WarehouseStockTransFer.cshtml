@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<style>
    .webiz-wt-page .select2-container {
        width: 100% !important;
        margin-bottom: 0;
    }
    .webiz-wt-page .select2-container--default .select2-selection--single {
        height: calc(1.5em + 0.5rem + 2px);
        min-height: calc(1.5em + 0.5rem + 2px);
        padding: 0.25rem 0.5rem;
        display: flex;
        align-items: center;
    }
    .webiz-wt-page .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #444;
        line-height: 1.5;
        padding-left: 0;
        padding-right: 1.25rem;
    }
    .webiz-wt-page .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: auto;
        top: 50%;
        transform: translateY(-50%);
        right: 0.35rem;
    }
    /* scan error toast Bootstrap modal ke upar dikhe */
    #overlay.overlay {
        z-index: 10200 !important;
    }
    #toast.toast-container {
        z-index: 10205 !important;
    }
    /* list / grid Action column ek line me */
    .webiz-wt-page #table.table tbody td:last-child,
    .webiz-wt-page #tblWtTable.table tbody td:last-child {
        white-space: nowrap;
    }
</style>

<div class="container webiz-wt-page">

    <!-- ========== LIST PAGE ========== -->
    <div class="mt-2 mt-md-3" id="wtListPage">
        <div class="card border-0 shadow-sm mb-3 p-1">
            <div class="card-body pb-0">
                <div class="row g-3 align-items-start" id="wtFilterBar">
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtFromDate" class="form-label form-label-sm mb-1 fw-semibold">From Date</label>
                        <input type="text" id="txtWtFromDate" class="form-control form-control-sm box_border" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtToDate" class="form-label form-label-sm mb-1 fw-semibold">To Date</label>
                        <input type="text" id="txtWtToDate" class="form-control form-control-sm box_border" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="ddlWtFilterWarehouse" class="form-label form-label-sm mb-1 fw-semibold">Warehouse</label>
                        <select id="ddlWtFilterWarehouse" class="form-control form-control-sm box_border" data-placeholder="All warehouses">
                            <option value="">All warehouses</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-auto d-flex flex-column">
                        <label class="form-label form-label-sm mb-1 fw-semibold invisible text-nowrap" aria-hidden="true">Filter</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary btn-height px-3" id="btnWtShow">Show</button>
                            <button type="button" class="btn btn-secondary btn-height px-3" id="btnWtReset">Reset</button>
                            <button type="button" class="btn btn-success btn-height px-3" id="btnWtCreateNew">
                                <i class="fa-solid fa-plus me-1"></i>Create New
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" id="wtGridCard">
            <div class="card-body p-0">
                <div class="table-wrapper fixed-height-table">
                    <table id="table" class="table mb-0">
                        <thead id="table-header"></thead>
                        <tbody id="table-body"></tbody>
                    </table>
                </div>
                <div class="paginator px-3 py-2 border-top border-light" id="paginator-table"></div>
            </div>
        </div>
    </div>

    <!-- ========== ENTRY PAGE (opens on Create New) ========== -->
    <div class="mt-2 mt-md-3 d-none" id="wtEntryPage">
        <div class="card border-0 shadow-sm mb-3 p-1">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-2 mb-3">
                    <h6 class="fw-semibold mb-0">
                        Warehouse Transfer Entry
                        <span id="wtStatusBadge" class="badge bg-warning text-dark ms-2 d-none">Pending</span>
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-info btn-sm btn-height px-3 d-none" id="btnWtPrint" title="Print Preview">
                            <i class="fa-solid fa-print me-1"></i>Print
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm btn-height px-3" id="btnWtBack">
                            <i class="fa-solid fa-arrow-left me-1"></i>Back
                        </button>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtEntryNo" class="form-label form-label-sm mb-1 fw-semibold">Entry No</label>
                        <input type="text" id="txtWtEntryNo" class="form-control form-control-sm box_border" autocomplete="off" readonly placeholder="Auto">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtDate" class="form-label form-label-sm mb-1 fw-semibold">Entry Date <span class="text-danger">*</span></label>
                        <input type="text" id="txtWtDate" class="form-control form-control-sm box_border" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="ddlWtFromWarehouse" class="form-label form-label-sm mb-1 fw-semibold">From Warehouse <span class="text-danger">*</span></label>
                        <select id="ddlWtFromWarehouse" class="form-control form-control-sm box_border" data-placeholder="Select warehouse">
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="ddlWtToWarehouse" class="form-label form-label-sm mb-1 fw-semibold">To Warehouse <span class="text-danger">*</span></label>
                        <select id="ddlWtToWarehouse" class="form-control form-control-sm box_border" data-placeholder="Select warehouse">
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtRefNo" class="form-label form-label-sm mb-1 fw-semibold">Ref No</label>
                        <input type="text" id="txtWtRefNo" class="form-control form-control-sm box_border" maxlength="50" autocomplete="off" placeholder="Ref No..">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtWtScanProduct" class="form-label form-label-sm mb-1 fw-semibold">Scan Product <span class="text-danger">*</span></label>
                        <input type="text" id="txtWtScanProduct" class="form-control form-control-sm box_border" maxlength="200" autocomplete="off" placeholder="Scan Product.." onfocus="this.select()">
                    </div>
                    <div class="col-sm-6 col-lg-3 d-flex flex-column">
                        <label class="form-label form-label-sm mb-1 fw-semibold invisible" aria-hidden="true">Keyboard</label>
                        <div class="d-flex align-items-center gap-1" style="height: calc(1.5em + 0.5rem + 2px);">
                            <input type="checkbox" id="txtIsManual" name="txtIsManual" class="box_border" />
                            <label for="txtIsManual" class="form-label-sm fw-bold mb-0"><nobr>Show Keyboard</nobr></label>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label form-label-sm mb-1 fw-semibold">Total Items / Qty</label>
                        <div style="font-size:22px;font-weight:bold;line-height:1.2;"><span id="wtTotalItems">0</span> / <span id="wtTotalQty">0</span></div>
                    </div>
                </div>
                <input type="hidden" id="hfWtCode" value="0" />
                <audio id="wtSuccessVoice" style="display:none;"><source src="~/assets/audio/voice.mp3" type="audio/mpeg" /></audio>
            </div>
        </div>

        <!-- scanned items grid -->
        <div class="card border-0 shadow-sm" id="wtDetailCard" style="display:none;">
            <div class="card-body p-0">
                <div class="table-wrapper fixed-height-table" style="overflow:auto;">
                    <table id="tblWtTable" class="fixed-width-table table mb-0">
                        <thead id="WtTable-Header"></thead>
                        <tbody id="WtTable-Body"></tbody>
                    </table>
                </div>
                <div class="paginator px-3 py-2 border-top border-light" id="paginator-tblWtTable"></div>
            </div>
        </div>
    </div>

    <!-- ========== PRINT PREVIEW MODAL ========== -->
    <div class="modal fade" id="modalWtPrint" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered my-2" style="width:96vw;max-width:1000px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-semibold mb-0">Print Preview - Item Godown Transfer</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-2 bg-light">
                    <iframe id="wtPrintFrame" title="Print Preview" style="width:100%;height:calc(100vh - 200px);min-height:300px;border:0;background:#d9dce1;"></iframe>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btnWtPrintNow">
                        <i class="fa-solid fa-print me-1"></i>Print
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>
    <div id="toast" class="toast-container"></div>
</div>

<script src="~/assets/js/CheckOptionPermission.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/js/filter.js"></script>
<script src="~/assets/Script/WarehouseTransfer.js"></script>
