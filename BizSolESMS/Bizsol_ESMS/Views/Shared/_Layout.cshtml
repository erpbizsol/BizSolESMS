                            @* <span class="d-none d-xl-inline-block ms-1 fw-medium">User</span>
                            <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i> *@
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <!-- item-->
                            <a class="dropdown-item" href="@Html.Raw(ViewBag.AppBaseURLMenu)/Master/UserMaster?Profile=1">
                                <i class='bx bxs-user align-middle userIcon me-1'></i> <span>Profile</span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#" onclick="logoutUser()">
                                <i class="bx bx-log-out align-middle me-1 userIcon"></i> <span>Logout</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

