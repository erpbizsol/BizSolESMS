        /* Keep aria-expanded in sync with real sidebar state (app.js toggles body classes). */
        (function syncSidebarToggleAria() {
            var mq = window.matchMedia('(max-width: 991.98px)');
            function go() {
                var btn = document.getElementById('vertical-menu-btn');
                if (!btn || !document.getElementById('esms-sidebar-panel')) return;
                if (mq.matches) {
                    btn.setAttribute('aria-expanded', document.body.classList.contains('sidebar-enable') ? 'true' : 'false');
                } else {
                    btn.setAttribute('aria-expanded', (document.body.getAttribute('data-sidebar-size') !== 'sm') ? 'true' : 'false');
                }
            }
            go();
            $(document).on('click', '#vertical-menu-btn', function () {
                window.setTimeout(go, 0);
            });
            $(document).on('click', '#sidebar-overlay', function () {
                window.setTimeout(go, 0);
            });
            $(window).on('resize', go);
            if (mq.addEventListener) mq.addEventListener('change', go);
            else mq.addListener(go);
        })();

        /* Highlight “Master” in page titles (mint word + underline) — matches reference shell */
        (function webizHeadingAccentMaster() {
            function esc(s) {
                return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }
            function wrap() {
                var el = document.getElementById('ERPHeading');
                var lw = document.getElementById('layout-wrapper');
                if (!el || !lw || !lw.classList.contains('esms-webiz')) return;
                if (el.querySelector('.esms-webiz-heading-em')) return;
                var t = (el.textContent || '').trim();
                var i = t.indexOf('Master');
                if (i < 0) return;
                el.innerHTML = esc(t.slice(0, i)) + '<span class="esms-webiz-heading-em">Master</span>' + esc(t.slice(i + 6));
            }
            wrap();
            var h = document.getElementById('ERPHeading');
            if (h && window.MutationObserver) {
                var obs = new MutationObserver(function () { window.requestAnimationFrame(wrap); });
                obs.observe(h, { childList: true, subtree: true, characterData: true });
            }
        })();
    </script>
