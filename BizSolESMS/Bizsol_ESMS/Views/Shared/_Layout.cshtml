    <script>
        /* ─── Global modal teleport ────────────────────────────────────────────────
         * Bootstrap appends .modal-backdrop directly to <body>.
         * Any .modal that lives inside #layout-wrapper sits in a nested stacking
         * context, so the backdrop always paints above it — the dialog looks dimmed
         * and buttons stop responding.
         * Fix: the moment ANY modal is about to show, move it to <body> so it shares
         * the same stacking context as .modal-backdrop and wins (z-index 10100 > 10095).
         * The Bootstrap Modal instance stays attached to the element (it's stored via
         * a WeakMap on the element itself), so all JS that calls
         *   bootstrap.Modal.getInstance(el)  or  new bootstrap.Modal(el)
         * continues to work without change.
         * ─────────────────────────────────────────────────────────────────────── */
        (function () {
            document.addEventListener('show.bs.modal', function (e) {
                var modal = e.target;
                if (modal && modal.parentElement && modal.parentElement !== document.body) {
                    document.body.appendChild(modal);
                }
            }, true);
        })();
    </script>
