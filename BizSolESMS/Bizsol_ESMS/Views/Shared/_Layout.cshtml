    <script>
        /* SM sidebar: clamp first-level submenu height to space below row (CSS positions list under “Master”) */
        (function ($) {
            var PAD = 8;

            function positionSmFlyout($li) {
                if (document.body.getAttribute('data-sidebar-size') !== 'sm') return;
                var li = $li[0];
                var sub = li.querySelector(':scope > ul.sub-menu');
                if (!sub) return;

                requestAnimationFrame(function () {
                    var liRect = li.getBoundingClientRect();
                    var available = Math.max(120, window.innerHeight - liRect.bottom - PAD);
                    sub.style.setProperty('max-height', available + 'px', 'important');
                });
            }

            function clearSmFlyout($li) {
                var li = $li[0];
                if (!li) return;
                var sub = li.querySelector(':scope > ul.sub-menu');
                if (!sub) return;
                sub.style.removeProperty('max-height');
            }

            $(document).on('mouseenter', '#layout-wrapper.esms-profenna #sidebar-menu > ul > li', function () {
                positionSmFlyout($(this));
            });
            $(document).on('mouseleave', '#layout-wrapper.esms-profenna #sidebar-menu > ul > li', function () {
                clearSmFlyout($(this));
            });
        })(jQuery);
    </script>
