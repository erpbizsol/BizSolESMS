@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
<script src="https://cdn.jsdelivr.net/gh/davidshimjs/qrcodejs/qrcode.min.js"></script>
<script src="~/assets/script/Dispatch.js"></script>
<script src="~/assets/js/blockui.js"></script>
<link href="~/assets/css/loader.css" rel="stylesheet" />
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        @* <a class="btn-icon me-1" onclick="Save()" id="txtsave" title="Save"><i class='bx bx-save'></i></a> *@
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container webiz-dispatch-page">
    <div class="mt-2 mt-md-3" id="txtListpage" style="display:block;">
        <div class="card webiz-dispatch-toolbar border-0 shadow-sm mb-3">
            <div class="card-body pb-0">
                <div class="row g-3 align-items-end" id="dvSearch">
                    <div class="col-sm-6 col-lg-3">
                        <label for="txtSearch" class="form-label form-label-sm mb-1 fw-semibold">Search</label>
                        <input type="text" id="txtSearch" name="txtSearch" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Search.." maxlength="50">
                    </div>
                    <div class="col-sm-6 col-lg-3" id="txtDownloadDate1">
                        <label for="txtDownloadDate" class="form-label form-label-sm mb-1 fw-semibold">From Date <span class="text-danger">*</span></label>
                        <input type="text" id="txtDownloadDate" name="txtDownloadDate" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Date.." maxlength="50">
                    </div>
                    <div class="col-sm-6 col-lg-3" id="txtToDate1">
                        <label for="txtToDate" class="form-label form-label-sm mb-1 fw-semibold">To Date <span class="text-danger">*</span></label>
                        <input type="text" id="txtToDate" name="txtToDate" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Date.." maxlength="50">
                    </div>
                    <div class="col-sm-6 col-lg-3" id="txtshowhide" style="display:none">
                        <label for="ddlOrderStatus" class="form-label form-label-sm mb-1 fw-semibold">Order Status <span class="text-danger">*</span></label>
                        <select id="ddlOrderStatus" name="ddlOrderStatus" autocomplete="off" class="form-control form-control-sm box_border">
                            <option value="Pending">Pending</option>
                            <option value="Partial">Partial</option>
                            <option value="Packed">Packed</option>
                        </select>
                    </div>
                    <div class="col-12 col-xl-auto ms-xl-auto d-flex flex-wrap gap-2 align-items-center justify-content-end pt-1 pt-lg-0" id="webizDispatchListActions">
                        <div class="d-inline-block" id="txtDownload">
                            <button type="button" class="btn btn-primary btn-height px-3" title="Download" onclick="DownloadInExcel()">Download</button>
                        </div>
                        <button type="button" class="btn btn-success btn-height px-3" title="Create Despatch" onclick="StartDispatchOrderNo('0')">CREATE NEW</button>
                    </div>
                </div>
            </div>
            <div class="card-footer webiz-dispatch-tabs-wrap bg-transparent border-top border-light py-3">
                <section class="breadcrumbs2 webiz-dispatch-breadcrumb mb-0">
                    <div class="container-fluid px-0">
                        <div class="fix-header">
                            <div class="tab-section webiz-dispatch-tabstrip">
                                <div class="nav-item" id="pendingOrder">
                                    <button type="button" class="nav-item-btn active" aria-pressed="true">
                                        <div id="tab" class="tab">Pending Order</div>
                                    </button>
                                </div>
                                <div class="nav-item" id="despatchTransit">
                                    <button type="button" class="nav-item-btn" aria-pressed="false">
                                        <div id="tab1" class="tab">Partial Packed</div>
                                    </button>
                                </div>
                                <div class="nav-item" id="completedDespatch">
                                    <button type="button" class="nav-item-btn" aria-pressed="false">
                                        <div id="tab2" class="tab">Order Packed</div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
        <div class="card webiz-dispatch-data border-0 shadow-sm" id="DataTable">
            <div class="card-body p-0">
            <div class="table-wrapper fixed-height-table webiz-dispatch-table-wrap">
                <table id="table" class="table mb-0">
                    <thead id="table-header">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
            <!-- Paginator -->
            <div class="paginator webiz-dispatch-paginator px-3 py-2 border-top border-light" id="paginator-table">
            </div>
            </div>
        </div>
    </div>
    <div id="txtCreatepage" style="display:none;">
        <div class="card shadow-sm" style="background-color:#e9e9ef">
            <div class="tabs">
                <div class="row p-1">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <audio id="SuccessVoice" style="display: none;"><source src="~/assets/audio/voice.mp3" type="audio/mpeg" /></audio>
                                <audio id="BoxNoVoice" style="display: none;"><source src="~/assets/audio/BoxNoVoice.mp3" type="audio/mpeg" /></audio>
                                <label for="txtOrderNo" class="col-form-label-sm fw-bold esms-order-level-field-label">Order No<span class="text-danger">*</span></label>
                                @* <input type="text" id="txtOrderNo" list="txtOrderNoList" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Order No.." disabled>
                                <datalist id="txtOrderNoList"></datalist> *@
                                <select id="txtOrderNo" class="form-control form-control-sm box_border">
                                </select>
                                <input type="hidden" id="hfCode" class="box_border form-control form-control-sm esms-order-level-placeholder" autocomplete="off" placeholder="Order No.." disabled value="0">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtChallanNo" class="col-form-label-sm fw-bold">Packing No<span class="text-danger">*</span></label>
                                <input type="text" id="txtChallanNo" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Challan No.." disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtChallanDate" class="col-form-label-sm fw-bold">Packing Date<span class="text-danger">*</span></label>
                                <input type="text" id="txtChallanDate" class="box_border form-control form-control-sm" autocomplete="off" placeholder="Challan Date.." disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtClientName" class="col-form-label-sm fw-bold">Client Name</label><span class="text-danger">*</span>
                                <input type="text" id="txtClientDispatchName" autocomplete="off" class="form-control form-control-sm box_border" placeholder="Client Name.." disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">

                                <label for="txtPackedBy" class="col-form-label-sm fw-bold">Packed By</label><span class="text-danger">*</span>
                                <input type="text" id="txtPackedBy" disabled class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" placeholder="Packed By..">
                            </div>
                            
                            <div class="col-md-3 col-sm-6">
                                <label for="txtScanProduct" class="col-form-label-sm fw-bold">Scan Product<span class="text-danger">*</span></label>
                                <input type="text" id="txtScanProduct" class="box_border form-control form-control-sm" autocomplete="off" maxlength="200" placeholder="Scan Product.." onfocus="this.select()">
                            </div>
                            <div class="col-md-2 without-label-field">
                                <label for="txtIsManual"></label>
                                <input type="checkbox" id="txtIsManual" name="txtIsManual" class="box_border" />
                                <label for="txtIsManual"><nobr>Show Keyboard</nobr></label>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <label for="txtBoxNo" class="col-form-label-sm fw-bold">Box No<span class="text-danger">*</span></label>
                                 <br/><button onclick="changeValue(-1)" style="border: 1px solid #275481;border-radius:4px;">➖</button>
                                <input type="text" id="txtBoxNo" class="Number" style="border: 1px solid #275481;width:45px;border-radius:4px;text-align:center;" value="1" min="1">
                                <button onclick="changeValue(1)" style="border: 1px solid #275481;border-radius:4px;">➕</button>
                            </div>
                            <div class="col-md-2 col-sm-6 mt-1">
                                <label for="txtTotalPartLine" class="fw-bold">Total Part Line</label>
                                <br/><label id="txtTotalPartLine" style="font-size:22px!important;font-weight:bold;"></label>
                            </div>
                        </div>
                    </div>
                </div>

                <datalist id="txtOrderNo"></datalist>
                <datalist id="txtClientNameList"></datalist>
                <datalist id="txtItemBarCode"></datalist>
                <datalist id="txtItemCode"></datalist>
                <datalist id="txtItemName"></datalist>
                <datalist id="txtItemAddress"></datalist>
            </div>
        </div>

    </div>
    <div>
        <div class="col-md-12 text-end mb-2" id="btnShowAll" style="display:none">
            <button class="btn btn-primary btn-height" title="Show all item" id="ShowAll">SHOW ALL</button>
        </div>
        <div class="row" id="divOrderBooking mb-2">
            <div class="accordion accordion-flush" id="accordionFlushOrder">
                <div class="accordion-item tab">
                    <div id="flush-collapseOrder" class="accordion-collapse collapse show" aria-labelledby="flush-collapseOrder" data-bs-parent="#accordionFlushOrder" style="">
                        <div class="accordion-body-sec">
                            <div class="row" id="tblDispatchData" style="display:none;">
                                <div class="col-md-12">
                                    <div class="table-wrapper fixed-height-table" style="overflow: auto;">
                                        <table id="tblDispatchTable" class="fixed-width-table table">
                                            <thead id="DispatchTable-Header">
                                            </thead>
                                            <tbody id="DispatchTable-Body"></tbody>
                                            <tfoot>
                                            </tfoot>
                                        </table>
                                    </div>
                                    <div class="paginator" id="paginator-tblDispatchTable">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="staticBackdrop" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-header tab-header" style="background-color:#033764">
                        <level style="color:white">Manual</level>
                        <button type="button" class="close modal-close btn-sm" aria-label="Close" onclick="CloseManualModal()"><span aria-hidden="true">x</span></button>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <span id="txtManualItemCode" style="display:inline;font-weight:bold"></span>
                        <span id="txtManualBalanceQuantity" style="display:inline;font-weight:bold"></span>
                        <div class="col-md-12 col-sm-12">
                            <label for="txtBoxNo" class="col-form-label-sm fw-bold">Box No <span class="text-danger">*</span></label>
                            <br /><button onclick="ManualChangeValue(-1)" style="border: 1px solid #275481;border-radius:4px;">➖</button>
                            <input type="text" id="txtManualBoxNo" class="Number" style="border: 1px solid #275481;width:45px;border-radius:4px;text-align:center;" value="1" min="1">
                            <button onclick="ManualChangeValue(1)" style="border: 1px solid #275481;border-radius:4px;">➕</button>
                        </div>
                        <div class="col-md-12 col-sm-12">
                            <label for="txtManualProductQuantity" class="col-form-label-sm fw-bold">Manual Product Quantity <span class="text-danger">*</span></label>
                            <input type="text" id="txtManualProductQuantity" class="box_border form-control form-control-sm Number" autocomplete="off" maxlength="10" placeholder="Manual Product Quantity..">
                            <input type="hidden" id="hfManualProductCode" class="box_border form-control form-control-sm" autocomplete="off" placeholder="">
                            <input type="hidden" id="hfManualProductQuantity" class="box_border form-control form-control-sm" autocomplete="off" placeholder="">
                        </div>
                        <div class="col-md-12 col-sm-12">
                            <label for="txtManualProductMRP" class="col-form-label-sm fw-bold">Manual Product MRP <span class="text-danger">*</span></label>
                            <input type="text" id="txtManualProductMRP" class="box_border form-control form-control-sm Amount" autocomplete="off" maxlength="10" placeholder="Manual Product MRP..">
                        </div>
                    </div>
                    <div class="text-right">
                        <button type="button" class="btn btn-primary btn-height" onclick="SaveManual()">Save</button>
                        <button type="button" class="btn btn-danger btn-height" onclick="CloseManualModal()">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="DownloadModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl px-2">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-header tab-header" style="background-color:#033764">
                        <level style="color:white">Download</level>
                        <button type="button" class="close modal-close btn-sm" aria-label="Close" onclick="CloseDownloadModal()"><span aria-hidden="true">x</span></button>
                        <input type="hidden" id="hfDownloadCode" value="0"/>
                    </div>
                    <div class="row" style="margin-top:10px;">
                        <div class="col-sm-4 text-center mb-2">
                            <div style="width:80px; height:80px; margin: 0 auto;">
                                <img src="~/assets/images/microsoft_office_excel.png" style="width:90%; height:90%;" />
                            </div>
                            <button type="button" class="btn btn-success w-100 mt-2 text-nowrap px-2" onclick="DispatchReport()">Download Excel</button>
                        </div>

                        <div class="col-sm-4 text-center ">
                            <div style="width:80px; height:80px; margin: 0 auto;">
                                <img src="~/assets/images/pdf icon.jpg" style="width:90%; height:90%;" />
                            </div>
                            <button type="button" class="btn btn-danger w-100 mt-2 text-nowrap px-2" onclick="DownloadReportPdf()">Download Pdf</button>
                        </div>
                        <div class="col-sm-4 text-center ">
                            <div style="width:80px; height:80px; margin: 0 auto;">
                                <img src="~/assets/images/qr-code.webp" style="width:90%; height:90%;" />
                            </div>
                            <button type="button" class="btn btn-dark w-100 mt-2 text-nowrap px-2" onclick="DownloadDispatchQR()">Dispatch QR</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>
    <div id="toast" class="toast-container"></div>
</div>
<div style="display:none;">
      <input type="text" id="txtCode" placeholder="Enter Text">
       <div id="qrcodeview" style="margin-top:20px"></div>
</div>
<script src="~/assets/js/filter.js"></script>

<script>
    (function () {
        const root = document.querySelector('.webiz-dispatch-page');
        if (!root) return;
        root.querySelectorAll('.webiz-dispatch-tabstrip .nav-item-btn').forEach(function (tab) {
            tab.addEventListener('click', function () {
                root.querySelectorAll('.webiz-dispatch-tabstrip .nav-item-btn').forEach(function (t) {
                    t.classList.remove('active');
                    t.setAttribute('aria-pressed', 'false');
                });
                tab.classList.add('active');
                tab.setAttribute('aria-pressed', 'true');
            });
        });
    })();
</script>