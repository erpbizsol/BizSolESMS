@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<script src="~/assets/script/ItemLocator.js"></script>
<script src="~/assets/js/autosuggestion.js"></script>
<div class="container-fluid esms-item-locator-page px-2 px-lg-3 pb-3">
    <div class="card shadow-sm border-0 textCreatepage esms-item-locator-card" id="ValidateFrom">
        <audio id="SuccessVoice" style="display: none;"><source src="~/assets/audio/voice.mp3" type="audio/mpeg" /></audio>
        <div class="card-body-esms esms-item-locator-inner px-2 px-md-3 py-3">
                <div class="d-flex flex-column flex-lg-row gap-2 gap-lg-3 mb-2 esms-item-locator-top">
                    <div class="flex-grow-1">
                    <h5 class="esms-item-locator-title mb-0">Product Rack Information</h5>
                        <p class="esms-item-locator-sub mb-0 mt-1">Choose box, barcode, or master item — then scan or pick.</p>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="esms-item-locator-label d-block mb-1">Identification mode</label>
                    <div class="esms-item-locator-modes d-flex flex-wrap gap-2" role="radiogroup" aria-label="Identification mode">
                        <label class="esms-mode-chip" title="Locate by carton / box barcode">
                            <input type="radio" id="txtScan" checked name="txtScan" value="1">
                            <span class="esms-mode-chip-inner"><i class="fa-solid fa-boxes-packing fa-fw fa-sm" aria-hidden="true"></i><span class="esms-mode-text">Scan box</span></span>
                        </label>
                        <label class="esms-mode-chip" title="Locate by item barcode scan">
                            <input type="radio" id="txtScan1" name="txtScan" value="2">
                            <span class="esms-mode-chip-inner"><i class="fa-solid fa-barcode fa-fw fa-sm" aria-hidden="true"></i><span class="esms-mode-text">Scan item</span></span>
                        </label>
                        <label class="esms-mode-chip" title="Pick from item master">
                            <input type="radio" id="txtScanItemCode" name="txtScan" value="3">
                            <span class="esms-mode-chip-inner"><i class="fa-solid fa-list-check fa-fw fa-sm" aria-hidden="true"></i><span class="esms-mode-text">Item code</span></span>
                        </label>
                    </div>
                </div>

                <div class="row g-2 esms-item-locator-input-row align-items-start mt-1">
                    <div class="col-12">
                        <div id="wrapperScanProduct" class="esms-item-locator-field">
                            <label for="txtScanProduct" class="esms-field-label">Scanner input <span class="text-danger">*</span></label>
                            <input type="text" id="txtScanProduct" class="box_border form-control form-control-sm esms-barcode-input esms-item-locator-scan" autocomplete="off" placeholder="Scan box or item barcode…" onfocus="this.select()">
                            <p class="esms-field-hint mb-0 mt-1">Keep focused while scanning.</p>
                        </div>
                        <div id="wrapperItemLocatorItem" class="esms-item-locator-field d-none">
                            <label for="ddlItemLocatorItem" class="esms-field-label">Item from master <span class="text-danger">*</span></label>
                            <select id="ddlItemLocatorItem" class="box_border form-control form-control-sm esms-item-locator-select" style="width:100%">
                                <option value="">Search by name or item code…</option>
                            </select>
                            <p class="esms-field-hint mb-0 mt-1">Select a row to load rack detail.</p>
                        </div>
                    </div>
                </div>
        </div>
    </div>

    <div class="mt-3 esms-item-locator-results" style="display:none" id="UnloadingTable">
        <div class="card shadow-sm border-0 esms-item-locator-table-card overflow-hidden">
            <div class="esms-results-header px-2 py-1 px-md-3 border-0 d-flex align-items-center gap-2">
                <span class="esms-results-title mb-0">Rack detail</span>
            </div>
            <div class="card-body p-2 p-md-3 pt-2">
                <div class="table-wrapper fixed-height-table">
                    <table id="table" class="fixed-width-table table ssm-table">
                        <thead id="table-header">
                        </thead>
                        <tbody id="table-body">
                        </tbody>
                    </table>
                </div>
                <div class="paginator" id="paginator-table"></div>
            </div>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>
    <div id="toast" class="toast-container"></div>
</div>

<div class="modal fade" id="LocationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content mt-5" style="max-width: 400px;">
            <div class="modal-header">
                <h5 class="modal-title">Create Location (Bin)</h5>
                <button type="button" class="close modal-close" aria-label="Close" onclick="ClearLocationData()" data-bs-dismiss="modal"><span aria-hidden="true">x</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 col-12">
                        <select id="mySelect2" class="form-control form-control-sm box_border" multiple style="width: 300px;" placeholder="Select locations..">
                        </select>
                    </div>
                </div>
                <div class="row d-none" id="divLocationModalWarehouse">
                    <div class="col-md-12 col-12 pt-2">
                        <label for="ddlLocationModalWarehouse" class="col-form-label-sm fw-bold mb-1">Warehouse <span class="text-danger">*</span></label>
                        <select id="ddlLocationModalWarehouse" class="form-control form-control-sm box_border"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-5 col-12 pt-2">
                        <input type="text" id="txtLocationName" name="txtLocationName" class="box_border form-control mb-0 form-control-sm" value="" autocomplete="off" placeholder="Create new location..." />
                        <input type="hidden" id="hfItemCode" name="hfItemCode" class="box_border form-control form-control-sm mb-0" value="0" autocomplete="off" />
                    </div>
                    <div class="col-md-7 col-12 pt-2">
                        <button type="button" title="Create new location" class="btn btn-info btn-height" id="btnCreateNew">Create</button>
                        <button type="button" title="Save" class="btn btn-success btn-height" id="btnSaveLocation">Save</button>&nbsp;
                        <button type="button" title="Close" class="btn btn-danger btn-height" aria-label="Close" onclick="ClearLocationData()" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/filter.js"></script>
