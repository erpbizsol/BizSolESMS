@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="~/assets/js/xlsx.full.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/script/SalesReturnMaster.js"></script>
<style>
    .esms-sr-page .od-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.22rem 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        white-space: nowrap;
        line-height: 1.35;
    }
    .esms-sr-page .od-status-badge i {
        font-size: 0.7rem;
        color: #000 !important;
    }
    .esms-sr-page .od-status-badge--scanning {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fdba74;
    }
    .esms-sr-page .od-status-badge--invoice-pending {
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #93c5fd;
    }
    .esms-sr-page .od-status-badge--invoice-generated {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #6ee7b7;
    }
    .esms-sr-page .od-status-badge--default {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }
    .esms-sr-page #txtordertable .table tbody td {
        vertical-align: middle;
        font-size: 0.8125rem;
    }
</style>
<section class="breadcrumbs1" id="txtheaderdiv" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackMaster()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="breadcrumbs1" id="txtheaderdiv2" style="display:none">
    <div class="container-fluid" style="">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" id="btnImport" onclick="SaveImportFile()" title="Save"><i class='bx bx-save'></i></a>
                        <a class="btn-icon btn-danger" id="btnBack" onclick="BackImport()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tab1" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="breadcrumbs1" id="txtheaderdivManual" style="display:none">
    <div class="container-fluid" style="">
        <div class="form-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon btn-danger" id="btnBackManual" onclick="BackManualSalesReturnPage()" title="Back"><i class='bx bx-arrow-back'></i></a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="tabManual" class="tabSec tab active">MANUAL</div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="container esms-sr-page">
    <div class="mt-3" id="txtListpage" style="display:block;">
        <div class="row">
            <div class="col-sm-12 text-end">
                <button type="button" class="btn btn-primary btn-height me-1" onclick="OpenManualSalesReturnPage()" id="btnManualSalesReturn">Manual</button>
                <button type="button" class="btn btn-info btn-height" onclick="ImportExcel()" id="ImportExcel">IMPORT</button>
           </div>
        </div>
        <div class="card-body mt-2" id="txtordertable">
            <div class="table-wrapper fixed-height-table">
                <table id="table" class="fixed-width-table table">
                    <thead id="table-header">
                    </thead>
                    <tbody id="table-body">
                    </tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-table">
            </div>
        </div>
    </div>
    <div class="textCreatepage" id="txtImportPage" style="display:none;">
        <div class="card shadow-sm">
            <div class="tabs">
                <div class="row p-2">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <audio id="SuccessVoice" style="display: none;"><source src="~/assets/audio/voice.mp3" type="audio/mpeg" /></audio>
                                <label for="txtOrderNo" class="col-form-label-sm fw-bold esms-order-level-field-label">Order No</label><span class="text-danger">*</span>
                                <input type="text" id="txtOrderNo" class="box_border form-control form-control-sm esms-order-level-placeholder-long" autocomplete="off" maxlength="25" placeholder="Please enter order no..">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtClientName" class="col-form-label-sm fw-bold">Client Name</label><span class="text-danger">*</span>
                                <select id="txtClientName" class="form-control form-control-sm box_border">
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtReason" class="col-form-label-sm fw-bold">Reason</label><span class="text-danger">*</span>
                                <select id="txtReason" class="box_border form-control form-control-sm">
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtImportWarehouse" class="col-form-label-sm fw-bold">Warehouse</label><span class="text-danger">*</span>
                                <select id="txtImportWarehouse" class="form-control form-control-sm box_border">
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtExcelFile" class="col-form-label-sm fw-bold">Choose File</label><span class="text-danger">*</span>
                                <input type="file" id="txtExcelFile" class="box_border form-control form-control-sm" autocomplete="off" accept=".xlsx, .xls, .csv">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body mt-2" id="ImportTable">
            <div class="table-wrapper fixed-height-table">
                <table id="table1" class="fixed-width-table table">
                    <thead id="table-header1">
                    </thead>
                    <tbody id="table-body1">
                    </tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-table1">
            </div>
        </div>
    </div>
    <div class="txtSalesValidate" id="txtSalesValidate" style="display:none;">
        <div class="card shadow-sm">
            <div class="tabs">
                <div class="row p-2">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <label for="txtSalesOrderNo" class="col-form-label-sm fw-bold esms-order-level-field-label">Order No</label><span class="text-danger">*</span>
                                <input type="text" id="txtSalesOrderNo" disabled class="box_border form-control form-control-sm esms-order-level-placeholder-long" autocomplete="off" maxlength="25" placeholder="Please enter order no..">
                                <input type="hidden" id="txthfCode" disabled class="box_border form-control form-control-sm" autocomplete="off" value="0">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtSalesClientName" class="col-form-label-sm fw-bold">Client Name</label><span class="text-danger">*</span>
                                <input type="text" id="txtSalesClientName" disabled class="box_border form-control form-control-sm" autocomplete="off" maxlength="25" placeholder="Please enter client name..">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtSalesReason" class="col-form-label-sm fw-bold">Reason</label><span class="text-danger">*</span>
                                <input type="text" id="txtSalesReason" disabled class="box_border form-control form-control-sm" autocomplete="off" maxlength="25" placeholder="Please enter reason..">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="txtScanProduct" class="col-form-label-sm fw-bold">Scan Product</label><span class="text-danger">*</span>
                                <input type="text" id="txtScanProduct" class="box_border form-control form-control-sm" autocomplete="off" maxlength="200" placeholder="Scan Product.." onfocus="this.select()">
                            </div>
                            <div class="col-md-2 col-sm-6 without-label-field">
                                <label for="txtIsManual"></label>
                                <input type="checkbox" id="txtIsManual" name="txtIsManual" class="box_border" />
                                <label for="txtIsManual"><nobr>Show Keyboard</nobr></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body mt-2" id="SalesTable">
            <div class="table-wrapper fixed-height-table">
                <table id="SalesTable" class="fixed-width-table table">
                    <thead id="SalesTable-header">
                    </thead>
                    <tbody id="SalesTable-body">
                    </tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-SalesTable">
            </div>
        </div>
    </div>

    <div class="textCreatepage" id="txtManualPage" style="display:none;">
        <div class="card shadow-sm" style="background-color:#e9e9ef">
            <div class="tabs">
                <div class="row p-1">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-3 col-sm-6">
                                <label for="msrDate" class="col-form-label-sm fw-bold">Date<span class="text-danger">*</span></label>
                                <input type="text" id="msrDate" class="form-control form-control-sm box_border" autocomplete="off" disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="msrClientName" class="col-form-label-sm fw-bold">Client Name<span class="text-danger">*</span></label>
                                <select id="msrClientName" class="form-control form-control-sm box_border"></select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="msrAddress" class="col-form-label-sm fw-bold">Address<span class="text-danger">*</span></label>
                                <input type="text" id="msrAddress" class="form-control form-control-sm box_border" placeholder="Address.." autocomplete="off" disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="msrOrderNo" class="col-form-label-sm fw-bold esms-order-level-field-label">Order No<span class="text-danger">*</span></label>
                                <select id="msrOrderNo" class="form-control form-control-sm box_border"></select>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3 col-sm-6">
                                <label for="msrWarehouse" class="col-form-label-sm fw-bold">Warehouse<span class="text-danger">*</span></label>
                                <select id="msrWarehouse" class="form-control form-control-sm box_border"></select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="msrReason" class="col-form-label-sm fw-bold">Reason<span class="text-danger">*</span></label>
                                <select id="msrReason" class="form-control form-control-sm box_border"></select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <audio id="msrSuccessVoice" style="display: none;"><source src="~/assets/audio/voice.mp3" type="audio/mpeg" /></audio>
                                <audio id="msrBoxNoVoice" style="display: none;"><source src="~/assets/audio/BoxNoVoice.mp3" type="audio/mpeg" /></audio>
                                <label for="msrScanProduct" class="col-form-label-sm fw-bold">Scan Product<span class="text-danger">*</span></label>
                                <input type="text" id="msrScanProduct" class="box_border form-control form-control-sm" autocomplete="off" maxlength="200" placeholder="Scan Product.." onfocus="this.select()" disabled>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label for="msrPackedBy" class="col-form-label-sm fw-bold">Scan By<span class="text-danger">*</span></label>
                                <input type="text" id="msrPackedBy" class="box_border form-control form-control-sm" autocomplete="off" maxlength="50" placeholder="Packed By.." disabled>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-end col-md-12" id="msrshow" style="display:none;">
            <label></label>
            <button type="button" class="btn btn-primary btn-height" title="Save All" id="msrSaveAll">Save</button>
        </div>
        <div class="text-end col-md-12" id="msrshowa" style="display:none;">
            <label></label>
            <button type="button" class="btn btn-primary btn-height" title="Save All" id="msrSaveAlls">Save</button>
        </div>
        <div class="card-body mt-2" id="msrDataTable" style="display:none;">
            <div class="table-wrapper fixed-height-table">
                <table id="msrTable" class="table">
                    <thead id="msr-table-header"></thead>
                    <tbody id="msr-table-body"></tbody>
                </table>
            </div>
            <div class="paginator" id="paginator-msrTable"></div>
        </div>
    </div>
</div>
<div id="overlay" class="overlay"></div>
<div id="toast" class="toast-container"></div>
<script src="~/assets/js/filter.js"></script>
<script src="~/assets/Script/SalesReturnManual.js"></script>

