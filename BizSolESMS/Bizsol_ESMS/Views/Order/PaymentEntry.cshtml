@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/filter.css" rel="stylesheet" />
<link href="~/assets/css/loader.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
<script src="~/assets/js/blockui.js"></script>
<script src="~/assets/js/autosuggestion.js"></script>

<style>
    .webiz-payment-page {
        --pe-primary:     #033764;
        --pe-primary-rgb: 3, 55, 100;
        --pe-border:      rgba(3, 55, 100, 0.12);
    }

    /* ── Filter bar Select2 ── */
    .webiz-payment-page #peFilterBar .select2-container                                               { width:100% !important; }
    .webiz-payment-page #peFilterBar .select2-container--default .select2-selection--single          { height:calc(1.5em + .5rem + 2px); padding:.25rem .5rem; display:flex; align-items:center; }
    .webiz-payment-page #peFilterBar .select2-container--default .select2-selection--single .select2-selection__rendered { color:#444; padding-left:0; padding-right:1.25rem; line-height:1.5; }
    .webiz-payment-page #peFilterBar .select2-container--default .select2-selection--single .select2-selection__arrow   { height:auto; top:50%; transform:translateY(-50%); right:.35rem; }


    /* ── Form card (compact + polished) ── */
    .webiz-payment-page .pe-form-card {
        position: relative;
        background: #fff;
        border: 1px solid rgba(var(--pe-primary-rgb), 0.14);
        border-radius: 11px;
        box-shadow: 0 2px 14px rgba(var(--pe-primary-rgb), 0.07);
        padding: 0.7rem 0.95rem 0.55rem;
        overflow: hidden;
    }
    .webiz-payment-page .pe-form-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--pe-primary) 0%, #1a6eb5 100%);
    }

    .webiz-payment-page .pe-meta-strip {
        padding: 0.4rem 0.55rem;
        margin-bottom: 0.45rem;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border: 1px solid rgba(var(--pe-primary-rgb), 0.09);
        border-radius: 8px;
    }

    .webiz-payment-page .pe-section-divider {
        display: flex; align-items: center; gap: .45rem;
        margin: 0.4rem 0 0.45rem;
    }
    .webiz-payment-page .pe-section-divider span {
        font-size: .62rem; font-weight: 700; letter-spacing: .07em;
        text-transform: uppercase; color: var(--pe-primary);
        white-space: nowrap;
        padding: 0.12rem 0.45rem;
        background: rgba(var(--pe-primary-rgb), 0.08);
        border-radius: 4px;
    }
    .webiz-payment-page .pe-section-divider::after {
        content: ''; flex: 1; height: 1px;
        background: linear-gradient(90deg, rgba(var(--pe-primary-rgb), .18) 0%, transparent 100%);
    }

    .webiz-payment-page .pe-field-label {
        font-size: 0.71rem; font-weight: 600; color: #475569;
        margin-bottom: 0.12rem; display: block; line-height: 1.15;
    }
    .webiz-payment-page .pe-field-label .req { color: #dc2626; }

    .webiz-payment-page .pe-input,
    .webiz-payment-page .pe-textarea {
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        font-size: 0.8125rem;
        padding: 0.3rem 0.55rem;
        min-height: 31px;
        transition: border-color .15s, box-shadow .15s, background .15s;
        background: #fff;
        color: #1e293b;
        width: 100%;
    }
    .webiz-payment-page .pe-textarea {
        min-height: 31px;
        max-height: 4.5rem;
        resize: vertical;
        line-height: 1.35;
    }
    .webiz-payment-page .pe-amount-field .pe-input.pe-amount {
        font-weight: 600;
        color: var(--pe-primary);
        background: rgba(var(--pe-primary-rgb), 0.04);
        border-color: rgba(var(--pe-primary-rgb), 0.22);
    }
    .webiz-payment-page .pe-amount-field .pe-input.pe-amount:focus {
        background: #fff;
    }
    .webiz-payment-page .pe-input:focus,
    .webiz-payment-page .pe-textarea:focus {
        border-color: var(--pe-primary);
        box-shadow: 0 0 0 3px rgba(var(--pe-primary-rgb), .1);
        outline: none;
    }
    .webiz-payment-page .pe-input.pe-readonly {
        background: #f1f5f9; color: #64748b; cursor: default;
    }
    .webiz-payment-page .pe-input.pe-amount { text-align: right; font-variant-numeric: tabular-nums; }

    /* Select2 in form ── */
    .webiz-payment-page .pe-form-card .select2-container                                     { width:100% !important; }
    .webiz-payment-page .pe-form-card .select2-container--default .select2-selection--single {
        height: 30px; border: 1px solid #d1dce8; border-radius: 6px;
        background: #fff; display: flex; align-items: center; padding: 0 .7rem;
        transition: border-color .18s, box-shadow .18s;
    }
    .webiz-payment-page .pe-form-card .select2-container--default.select2-container--focus .select2-selection--single,
    .webiz-payment-page .pe-form-card .select2-container--default.select2-container--open  .select2-selection--single {
        border-color: var(--pe-primary);
        box-shadow: 0 0 0 3px rgba(var(--pe-primary-rgb), .1);
    }
    .webiz-payment-page .pe-form-card .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #1e293b; line-height: 1.5; padding-left: 0; padding-right: 1.25rem;
    }
    .webiz-payment-page .pe-form-card .select2-container--default .select2-selection--single .select2-selection__placeholder { color: #94a3b8; }
    .webiz-payment-page .pe-form-card .select2-container--default .select2-selection--single .select2-selection__arrow { height:auto; top:50%; transform:translateY(-50%); right:.4rem; }
    .webiz-payment-page .pe-form-card .select2-dropdown { border:1.5px solid #d1dce8; border-radius:8px; box-shadow:0 8px 24px rgba(var(--pe-primary-rgb),.12); }

    .webiz-payment-page .pe-note {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.45rem;
        padding: 0.32rem 0.55rem;
        font-size: 0.68rem;
        line-height: 1.3;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid rgba(var(--pe-primary-rgb), 0.08);
        border-radius: 6px;
    }
    .webiz-payment-page .pe-note > i {
        color: var(--pe-primary);
        font-size: 0.7rem;
        flex-shrink: 0;
        opacity: 0.85;
    }

    /* ── Invoice grid ── */
    #tblPEInvoice thead th {
        font-size: .75rem; font-weight: 700; letter-spacing: .04em;
        text-transform: uppercase; color: #475569;
        padding: .45rem .75rem; border-bottom: 2px solid rgba(3,55,100,.12);
    }
    #tblPEInvoice tbody td { font-size: .84rem; padding: .4rem .75rem; vertical-align: middle; }
    #tblPEInvoice tbody tr:hover { background: rgba(3,55,100,.03); }

    /* ── Responsive ── */
    @@media (max-width: 767.98px) {
        .webiz-payment-page .pe-form-card { padding: 0.65rem 0.75rem; }
    }
</style>

<!-- ══ Sticky toolbar — outside container, same pattern as MRNMaster ══ -->
<section class="breadcrumbs1" id="peToolbar" style="display:none;">
    <div class="container-fluid">
        <div class="fix-header">
            <div class="row">
                <div class="col-md-6 col-6">
                    <div class="icon-tab">
                        <a class="btn-icon me-1" onclick="PESavePaymentEntry()" id="btnPESave" title="Save">
                            <i class='bx bx-save'></i>
                        </a>
                        <a class="btn-icon me-1" onclick="PEResetForm()" title="Reset">
                            <i class='bx bx-revision'></i>
                        </a>
                        <a class="btn-icon btn-danger" onclick="PEShowListPage()" title="Back to List">
                            <i class='bx bx-arrow-back'></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-6 col-6">
                    <div id="lblPEFormBadge" class="tabSec tab active">NEW</div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container webiz-payment-page mt-2 mt-md-3">
    <div id="peListPage">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body pb-2 pt-3 px-3">
                <!-- Filter bar -->
                <div class="row g-2 align-items-end" id="peFilterBar">
                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label form-label-sm mb-1 fw-semibold" for="txtPEFromDate">From Date</label>
                        <input type="text" id="txtPEFromDate" class="form-control form-control box_border"
                               autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label form-label-sm mb-1 fw-semibold" for="txtPEToDate">To Date</label>
                        <input type="text" id="txtPEToDate" class="form-control form-control box_border"
                               autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label form-label-sm mb-1 fw-semibold" for="ddlPEPartyFilter">Party Name</label>
                        <select id="ddlPEPartyFilter" class="form-control form-control box_border" data-placeholder="All parties">
                            <option value="">All parties</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label form-label-sm mb-1 fw-semibold" for="txtPEPayModeFilter">Credit Note</label>
                        <input type="text" id="txtPEPayModeFilter" class="form-control form-control box_border"
                               autocomplete="off" maxlength="50" placeholder="All">
                        <ul id="txtPEPayModeFilterList" class="AutoSuggestion-list"></ul>
                    </div>
                    <div class="col-12 col-lg-auto">
                        <label class="form-label form-label-sm mb-1 invisible" aria-hidden="true">x</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary btn-height px-3" id="btnPEApplyFilter">
                                <i class="fa fa-search me-1"></i>Apply
                            </button>
                            <button type="button" class="btn btn-secondary btn-height px-3" id="btnPEResetFilter">
                                <i class="fa fa-undo me-1"></i>Reset
                            </button>
                            <button type="button" class="btn btn-success btn-height px-3" onclick="PEShowCreatePage()">
                                <i class="fa fa-plus me-1"></i>New
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- List grid -->
        <div class="card border-0 shadow-sm mt-2" id="peListTable">
            <div class="card-body p-0">
                <div class="table-wrapper fixed-height-table">
                    <table id="table" class="fixed-width-table table mb-0">
                        <thead id="table-header"></thead>
                        <tbody id="table-body"></tbody>
                    </table>
                </div>
                <div class="paginator px-3 py-2 border-top border-light" id="paginator-table"></div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════ CREATE / EDIT PAGE ══════════════════════════ -->
    <div id="peCreatePage" style="display:none;">

        <!-- Form card -->
        <div class="pe-form-card mt-2">

            <div class="pe-meta-strip">
                <div class="row g-2 mb-0">
                    <div class="col-md-2 col-4">
                        <label class="pe-field-label" for="txtPEEntryNo">Entry No</label>
                        <input type="text" id="txtPEEntryNo" class="pe-input pe-readonly"
                               autocomplete="off" placeholder="Auto" disabled>
                    </div>
                    <div class="col-md-2 col-4">
                        <label class="pe-field-label" for="txtPEDate">Date <span class="req">*</span></label>
                        <input type="text" id="txtPEDate" class="pe-input" autocomplete="off" placeholder="DD-MM-YYYY">
                    </div>
                </div>
            </div>

            <div class="pe-section-divider"><span>Payment Details</span></div>

            <div class="row g-2">
                <div class="col-md-5 col-12">
                    <label class="pe-field-label" for="ddlPEPartyName">Party Name <span class="req">*</span></label>
                    <select id="ddlPEPartyName" class="form-control" data-placeholder="-- Select Party --">
                        <option value=""></option>
                    </select>
                </div>
                <div class="col-md-3 col-6">
                    <label class="pe-field-label" for="txtPEPayMode">Credit Note <span class="req">*</span></label>
                    <input type="text" id="txtPEPayMode" class="pe-input" autocomplete="off" maxlength="50"
                           placeholder="Credit Note">
                    <ul id="txtPEPayModeList" class="AutoSuggestion-list"></ul>
                </div>
                <div class="col-md-4 col-6">
                    <label class="pe-field-label" for="txtPERefNo">Ref No <span class="req">*</span></label>
                    <input type="text" id="txtPERefNo" class="pe-input" autocomplete="off" maxlength="100"
                           placeholder="Ref No">
                </div>
            </div>

            <div class="row g-2 mt-0">
                <div class="col-md-2 col-4 pe-amount-field">
                    <label class="pe-field-label" for="txtPEAmount">Amount <span class="req">*</span></label>
                    <input type="text" id="txtPEAmount" class="pe-input pe-amount" autocomplete="off" maxlength="18"
                           placeholder="0.00" oninput="PEFormatAmountInput(this)" onblur="PEAmountBlur()">
                </div>
                <div class="col-md-10 col-8">
                    <label class="pe-field-label" for="txtPENarration">Narration <span class="req">*</span></label>
                    <textarea id="txtPENarration" class="pe-textarea" rows="1" maxlength="500"
                              placeholder="Narration..."></textarea>
                </div>
            </div>

            <div class="pe-note">
                <i class="fa fa-circle-info"></i>
                <span>Bill payment ≤ Amount · Advance = Amount − Total (auto)</span>
            </div>
        </div>

        <!-- ── Bill Allocation Grid ── -->
        <div id="peInvoiceGridSection" class="card border-0 shadow-sm mt-3" style="display:none;">
            <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between"
                 style="background:linear-gradient(135deg,#f0f4fa 0%,#e8eef7 100%);border-bottom:1px solid rgba(3,55,100,.12);">
                <span class="fw-semibold" style="font-size:.85rem;color:#033764;">
                    <i class="fa fa-file-invoice me-1"></i>Bill Allocation
                </span>
                <button type="button" class="btn btn-sm btn-success px-3" onclick="PEAutoAllocatePayment()" title="Allocate Amount to bills from top">
                    <i class="fa fa-calculator me-1"></i>Amount Adjusted
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0" id="tblPEInvoice">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th style="width:40px;">Sr</th>
                                <th>Bill No</th>
                                <th>Bill Date</th>
                                <th class="text-end">Bill Amount</th>
                                <th class="text-end">Amt Adjusted</th>
                                <th class="text-end">Payable Amt</th>
                                <th class="text-end" style="min-width:130px;">
                                    Payment Amt <span style="color:#e53e3e;">*</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="tblPEInvoiceBody">
                            <tr>
                                    <td colspan="7" class="text-center text-muted py-3">
                                    Select a party to load bills.
                                </td>
                            </tr>
                        </tbody>
                        <tfoot id="tblPEInvoiceFoot" style="display:none;">
                            <tr class="fw-semibold" style="background:#f0f4fa;">
                                <td colspan="5" class="text-end py-2" style="font-size:.82rem;color:#033764;">Total</td>
                                <td class="text-end py-2" id="tdPETotalPayable" style="font-variant-numeric:tabular-nums;">0.00</td>
                                <td class="text-end py-2" id="tdPETotalPayment" style="font-variant-numeric:tabular-nums;">0.00</td>
                            </tr>
                            <tr style="background:#f8fafc;">
                                <td colspan="5" class="text-end py-2" style="font-size:.82rem;color:#475569;">Advance / On account</td>
                                <td></td>
                                <td class="text-end py-1">
                                    <input type="text" id="txtPEAdvance" class="pe-input pe-readonly text-end"
                                           style="font-size:.84rem;max-width:120px;display:inline-block;"
                                           placeholder="0.00" readonly tabindex="-1">
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════ DELETE MODAL ══════════════════════════ -->
<div class="modal fade" id="modalPEDelete" tabindex="-1" aria-labelledby="modalPEDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border:none;border-radius:12px;overflow:hidden;">
            <div class="modal-header py-2" style="background:#dc3545;">
                <h5 class="modal-title text-white mb-0" id="modalPEDeleteLabel">
                    <i class="fa fa-trash me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Are you sure you want to delete payment entry <strong id="lblPEDeleteEntry"></strong>?</p>
                <p class="text-danger small mb-0">
                    <i class="fa fa-exclamation-triangle me-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-height" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-height px-4" onclick="PEConfirmDelete()">
                    <i class="fa fa-trash me-1"></i>Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/filter.js"></script>
<script src="~/assets/Script/PaymentEntry.js"></script>
