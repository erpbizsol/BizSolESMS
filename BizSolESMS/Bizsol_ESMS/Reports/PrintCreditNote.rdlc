              <Paragraph><TextRuns><TextRun><Value>=UCase(First(Fields!PartyName.Value, "PrintCreditNote"))</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><LineHeight>12pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=First(Fields!PartyAddressDisplay.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><LineHeight>11pt</LineHeight></Style></Paragraph>
