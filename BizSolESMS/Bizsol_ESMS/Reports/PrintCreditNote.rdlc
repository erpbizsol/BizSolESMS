          <Textbox Name="tbCompanyBlock">
            <CanGrow>false</CanGrow>
            <Paragraphs>
              <Paragraph><TextRuns><TextRun><Value>=UCase(First(Fields!CompanyName.Value, "PrintCreditNote"))</Value><Style><FontWeight>Bold</FontWeight><FontSize>12pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>12pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyAddressLine1.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>11pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyAddressLine2.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>11pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=First(Fields!CompanyCityNationPin.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>11pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=IIF(Trim(First(Fields!CompanyMobile.Value, "PrintCreditNote"))&lt;&gt;"", "Ph. : ", "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=First(Fields!CompanyMobile.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!CompanyMobile.Value, "PrintCreditNote"))&lt;&gt;"", IIF(Trim(First(Fields!CompanyEmail.Value, "PrintCreditNote"))&lt;&gt;"", " , ", ""), "")</Value><Style><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!CompanyEmail.Value, "PrintCreditNote"))&lt;&gt;"", "E-mail : ", "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=First(Fields!CompanyEmail.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>11pt</LineHeight></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=IIF(Trim(First(Fields!CompanyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"", "GSTIN : ", "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=First(Fields!CompanyGSTNo.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!CompanyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"", IIF(Trim(First(Fields!CompanyPANNo.Value, "PrintCreditNote"))&lt;&gt;"", " , PAN No. : ", ""), "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=First(Fields!CompanyPANNo.Value, "PrintCreditNote")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign><LineHeight>11pt</LineHeight></Style></Paragraph>
