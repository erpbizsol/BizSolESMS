              <Paragraph><TextRuns><TextRun><Value>=IIF(Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"0", "GST No. : ", "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"0", First(Fields!PartyGSTNo.Value, "PrintCreditNote"), "")</Value><Style><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyGSTNo.Value, "PrintCreditNote"))&lt;&gt;"0", IIF(Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"0", "     ", ""), "")</Value><Style><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"0", "State Code : ", "")</Value><Style><FontWeight>Bold</FontWeight><FontSize>10pt</FontSize></Style></TextRun><TextRun><Value>=IIF(Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"" AND Trim(First(Fields!PartyStateCode.Value, "PrintCreditNote"))&lt;&gt;"0", First(Fields!PartyStateCode.Value, "PrintCreditNote"), "")</Value><Style><FontSize>10pt</FontSize></Style></TextRun></TextRuns><Style><LineHeight>11pt</LineHeight></Style></Paragraph>
